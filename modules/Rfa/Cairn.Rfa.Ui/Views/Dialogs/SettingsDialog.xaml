<Window x:Class="Cairn.Rfa.Ui.Views.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="680" Height="760" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource DialogHeading}" Text="Settings" Margin="0,0,0,12" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
      <StackPanel>
        <!-- Theme -->
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="APPEARANCE" />
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Margin="0,0,16,0" IsChecked="{Binding IsThemeSystem, Mode=TwoWay}"
                         ToolTip="Use whichever theme Windows is set to" AutomationProperties.Name="Follow Windows theme">
              <AccessText Text="Follow _Windows" />
            </RadioButton>
            <RadioButton GroupName="Theme" Margin="0,0,16,0" IsChecked="{Binding IsThemeLight, Mode=TwoWay}"
                         ToolTip="Always use the light colour set" AutomationProperties.Name="Light theme">
              <AccessText Text="_Light" />
            </RadioButton>
            <RadioButton GroupName="Theme" IsChecked="{Binding IsThemeDark, Mode=TwoWay}"
                         ToolTip="Always use the dark colour set" AutomationProperties.Name="Dark theme">
              <AccessText Text="_Dark" />
            </RadioButton>
          </StackPanel>
          <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="The theme changes as you pick it. Cancel puts the old one back." />
        </StackPanel>

        <!-- Game directory -->
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="RED FACTION FOLDER" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="8,0,0,0" Content="A_uto-detect"
                    Command="{Binding AutoDetectCommand}"
                    ToolTip="Look at Alpine Faction's setting, the registry and the usual Steam, GOG and retail install paths"
                    AutomationProperties.Name="Auto-detect the game folder" />
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="8,0,0,0" Content="_Browse…"
                    Command="{Binding BrowseGameDirectoryCommand}" ToolTip="Choose the folder that holds RF.exe"
                    AutomationProperties.Name="Browse for the game folder" />
            <TextBox MinHeight="30" VerticalContentAlignment="Center"
                     Text="{Binding GameDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="The game's .vpp archives and user_maps folders are searched last"
                     AutomationProperties.Name="Red Faction folder" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Top" Margin="0,1,6,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE7BA;" />
                  <Setter Property="Foreground" Value="{DynamicResource Severity.Warning}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsGameDirectoryValid}" Value="True">
                      <Setter Property="Text" Value="&#xE73E;" />
                      <Setter Property="Foreground" Value="{DynamicResource Severity.Info}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Style="{StaticResource HintText}" MaxWidth="540" Text="{Binding GameDirectoryStatus}"
                       AutomationProperties.Name="Game folder status" />
          </StackPanel>
          <TextBlock Style="{StaticResource HintText}" Margin="18,4,0,0" MaxWidth="540" Text="{Binding DetectionHint}"
                     Visibility="{Binding HasDetectionHint, Converter={StaticResource Truthy}}"
                     AutomationProperties.Name="Where the game folder was found" />
        </StackPanel>

        <!-- Search folders -->
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="SEARCH FOLDERS" />
          <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                     Text="Extra folders searched for clips, meshes, tables and textures, in this order, after the open file's own folder and before the game. Loose files come before any .vpp in the same folder." />
          <Grid Height="124">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource DialogCard}" Padding="0">
              <ListBox ItemsSource="{Binding SearchFolders}" BorderThickness="0" Background="Transparent"
                       SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" AutomationProperties.Name="Search folders">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,0,6" Content="_Add…" Command="{Binding AddFolderCommand}"
                      ToolTip="Choose another folder to search" AutomationProperties.Name="Add a search folder" />
              <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,0,6" Content="_Remove" Command="{Binding RemoveFolderCommand}"
                      ToolTip="Stop searching the selected folder" AutomationProperties.Name="Remove the selected folder" />
              <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,0,6" Content="Move up" Command="{Binding MoveUpCommand}"
                      ToolTip="Search this folder earlier" AutomationProperties.Name="Move the folder up" />
              <Button Style="{StaticResource DialogSmallButton}" Margin="0" Content="Move down" Command="{Binding MoveDownCommand}"
                      ToolTip="Search this folder later" AutomationProperties.Name="Move the folder down" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Library, viewport and time display: also the shell's "Animations and meshes" settings page (RfaSettingsPage). -->
        <StackPanel x:Name="ModuleSections">
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="LIBRARY" />
          <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="Double-click (or Enter) on a clip or mesh in the library:" />
          <RadioButton GroupName="LibraryDoubleClick" Margin="0,0,0,4" IsChecked="{Binding IsDoubleClickPreview, Mode=TwoWay}"
                       ToolTip="With a mesh in front, a clip plays on it; with a clip in front, a mesh becomes its preview mesh and another clip opens in a new tab on the same mesh. A bone count that does not fit opens a new tab instead."
                       AutomationProperties.Name="Double-click previews on the current document">
            <AccessText Text="Pre_view on the current document (default)" />
          </RadioButton>
          <RadioButton GroupName="LibraryDoubleClick" IsChecked="{Binding IsDoubleClickNewTab, Mode=TwoWay}"
                       ToolTip="Every double-click opens the clip or mesh in a tab of its own"
                       AutomationProperties.Name="Double-click always opens a new tab">
            <AccessText Text="Alwa_ys open in a new tab" />
          </RadioButton>
          <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                     Text="Ctrl+double-click, Ctrl+Enter, middle-click and the context menu's Open in new tab always open a new tab." />
        </StackPanel>

        <!-- Viewport defaults -->
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="VIEWPORT" />
          <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                     Text="What every viewport shows. The viewport's own toolbar changes the same settings." />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource DialogLabel}" Text="Mesh" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton GroupName="MeshMode" Margin="0,0,14,0" IsChecked="{Binding Display.IsMeshTextured, Mode=TwoWay}"
                         ToolTip="Draw the mesh with its textures" AutomationProperties.Name="Textured mesh">
              <AccessText Text="_Textured" />
            </RadioButton>
            <RadioButton GroupName="MeshMode" Margin="0,0,14,0" IsChecked="{Binding Display.IsMeshFlat, Mode=TwoWay}"
                         ToolTip="Draw the mesh in one neutral colour" AutomationProperties.Name="Flat mesh">
              <AccessText Text="_Flat" />
            </RadioButton>
            <RadioButton GroupName="MeshMode" IsChecked="{Binding Display.IsMeshOff, Mode=TwoWay}"
                         ToolTip="Do not draw the mesh" AutomationProperties.Name="Hide the mesh">
              <AccessText Text="_Hidden" />
            </RadioButton>
          </StackPanel>
          <UniformGrid Columns="3" Margin="0,0,0,8">
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.ShowSkeleton, Mode=TwoWay}" ToolTip="Bones and joints" AutomationProperties.Name="Skeleton">
              <AccessText Text="_Skeleton" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.ShowBoneNames, Mode=TwoWay}" ToolTip="Bone, sphere and prop point names" AutomationProperties.Name="Bone names">
              <AccessText Text="Bone _names" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.ShowGrid, Mode=TwoWay}" ToolTip="Ground grid and axes" AutomationProperties.Name="Grid and axes">
              <AccessText Text="_Grid and axes" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.ShowSpheres, Mode=TwoWay}" ToolTip="Collision spheres" AutomationProperties.Name="Collision spheres">
              <AccessText Text="_Collision spheres" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.ShowProps, Mode=TwoWay}" ToolTip="Prop points" AutomationProperties.Name="Prop points">
              <AccessText Text="_Prop points" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.ShowRootPath, Mode=TwoWay}" ToolTip="The root bone's path over the clip" AutomationProperties.Name="Root motion path">
              <AccessText Text="Root _motion path" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.FullBright, Mode=TwoWay}" ToolTip="Unlit textures" AutomationProperties.Name="Full bright">
              <AccessText Text="Full bright" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.Perspective, Mode=TwoWay}" ToolTip="Perspective projection (off: orthographic)" AutomationProperties.Name="Perspective">
              <AccessText Text="P_erspective" />
            </CheckBox>
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding Display.BindPose, Mode=TwoWay}" ToolTip="Show the mesh's rest pose instead of the clip" AutomationProperties.Name="Bind pose">
              <AccessText Text="Bind p_ose" />
            </CheckBox>
          </UniformGrid>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource DialogLabel}" Text="Background" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Width="180" MinHeight="28" ItemsSource="{Binding BackgroundLabels}" SelectedIndex="{Binding BackgroundIndex, Mode=TwoWay}"
                      ToolTip="The viewport's background colour" AutomationProperties.Name="Viewport background" />
          </StackPanel>
        </StackPanel>

        <!-- Time display -->
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="TIME DISPLAY" />
          <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="Unit" Margin="0,0,16,0" IsChecked="{Binding IsUnitFrames, Mode=TwoWay}"
                         ToolTip="Frames at 30 fps (160 ticks); stock clips start at frame 1" AutomationProperties.Name="Frames">
              <AccessText Text="Frames" />
            </RadioButton>
            <RadioButton GroupName="Unit" Margin="0,0,16,0" IsChecked="{Binding IsUnitSeconds, Mode=TwoWay}"
                         ToolTip="Seconds (4800 ticks)" AutomationProperties.Name="Seconds">
              <AccessText Text="Seconds" />
            </RadioButton>
            <RadioButton GroupName="Unit" IsChecked="{Binding IsUnitTicks, Mode=TwoWay}"
                         ToolTip="Ticks, as the file stores them (1/4800 s)" AutomationProperties.Name="Ticks">
              <AccessText Text="T_icks" />
            </RadioButton>
          </StackPanel>
        </StackPanel>
        </StackPanel>

        <!-- Search order -->
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="RESOLVED SEARCH ORDER" />
          <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding SearchOrderCaption}" />
          <Border Style="{StaticResource DialogCard}" MaxHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SearchOrder}" AutomationProperties.Name="Resolved search order">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Style="{StaticResource MonoText}" Text="{Binding}" ToolTip="{Binding}" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource DialogButton}" Content="OK" IsDefault="True" Click="OnOk" AutomationProperties.Name="OK" />
      <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True" AutomationProperties.Name="Cancel" />
    </StackPanel>
  </Grid>
</Window>
