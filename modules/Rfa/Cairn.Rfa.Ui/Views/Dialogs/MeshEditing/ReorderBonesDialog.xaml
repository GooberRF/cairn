<Window x:Class="Cairn.Rfa.Ui.Views.Dialogs.MeshEditing.ReorderBonesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="560" Height="640" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="20,18,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource DialogHeading}" Text="{Binding Heading}" AutomationProperties.Name="Heading" />

    <!-- The warning -->
    <Border Grid.Row="1" Margin="0,6,0,12" Padding="12,8" CornerRadius="4" BorderThickness="1"
            Background="{DynamicResource Banner.NoticeBackground}" BorderBrush="{DynamicResource Banner.NoticeBorder}"
            AutomationProperties.Name="Warning: clips address bones by index">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,1,10,0"
                   VerticalAlignment="Top" Foreground="{DynamicResource Severity.Warning}" />
        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Banner.Foreground}" />
      </DockPanel>
    </Border>

    <!-- The new order -->
    <DockPanel Grid.Row="2" Margin="0,0,0,12">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeText}" Style="{StaticResource HintText}" VerticalAlignment="Center"
                   AutomationProperties.Name="How many bones change index" />
        <TextBlock Text="NEW ORDER" Style="{StaticResource DialogSubheading}" Margin="0" VerticalAlignment="Center" />
      </DockPanel>
      <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
        <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,0,6" Command="{Binding MoveUpCommand}"
                ToolTip="Move the selected bone one place up (Alt+Up in the list)" AutomationProperties.Name="Move the bone up">
          <AccessText Text="Move _up" />
        </Button>
        <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,0,6" Command="{Binding MoveDownCommand}"
                ToolTip="Move the selected bone one place down (Alt+Down in the list)" AutomationProperties.Name="Move the bone down">
          <AccessText Text="Move _down" />
        </Button>
        <Button Style="{StaticResource DialogSmallButton}" Margin="0" Command="{Binding ResetCommand}"
                ToolTip="Put every bone back at its current index" AutomationProperties.Name="Reset the order">
          <AccessText Text="_Reset" />
        </Button>
      </StackPanel>
      <Border Style="{StaticResource DialogCard}" Padding="2">
        <ListBox x:Name="BoneList" ItemsSource="{Binding Bones}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent" PreviewKeyDown="OnListKeyDown"
                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Bones in their new order">
          <ListBox.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource PaneScrollBar}" />
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding MovedText}" FontSize="11" Margin="12,0,4,0"
                           Foreground="{DynamicResource Severity.Warning}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>

    <!-- The clips that would play wrong -->
    <StackPanel Grid.Row="3" Margin="0,0,0,4">
      <TextBlock Text="OPEN CLIPS PREVIEWING THIS MESH" Style="{StaticResource DialogSubheading}" />
      <ItemsControl ItemsSource="{Binding Clips}" Focusable="False" Visibility="{Binding HasClips, Converter={StaticResource Truthy}}"
                    AutomationProperties.Name="Clips to conform">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Style="{StaticResource HintText}" Margin="12,0,0,0" VerticalAlignment="Center" />
              <CheckBox IsChecked="{Binding Conform, Mode=TwoWay}" IsEnabled="{Binding CanConform}" Foreground="{DynamicResource App.Text}"
                        ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Label}">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </CheckBox>
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding ClipsHint}" Style="{StaticResource HintText}" />
    </StackPanel>

    <DockPanel Grid.Row="4" Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource Truthy}}">
      <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,7,0"
                 Foreground="{DynamicResource Severity.Error}" />
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Severity.Error}"
                 AutomationProperties.Name="Why the bones cannot be reordered" />
    </DockPanel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource DialogButton}" IsDefault="True" Click="OnOk" Content="{Binding ApplyText}"
              ToolTip="Reorder the bones (one undo step) and conform the ticked clips (one step in each) — Enter"
              AutomationProperties.Name="{Binding ApplyText}" />
      <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True"
              ToolTip="Close without changing anything (Esc)" AutomationProperties.Name="Cancel" />
    </StackPanel>
  </Grid>
</Window>
