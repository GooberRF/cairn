<Window x:Class="Cairn.Rfa.Ui.Views.Dialogs.Gltf.GltfExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="980" Height="820" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- File › Export to glTF… (GltfExportViewModel). Theme brushes only. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GltfDialogResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,18,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource DialogHeading}" Text="{Binding Heading}" />
      <TextBlock Style="{StaticResource HintText}" Text="{Binding Description}" />
      <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource App.Text}" Text="{Binding SourceSummary}"
                 TextWrapping="Wrap" AutomationProperties.Name="What is exported" />
      <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Severity.Warning}" Text="{Binding MismatchText}"
                 Visibility="{Binding MismatchText, Converter={StaticResource Truthy}}" AutomationProperties.Name="Bone count warning" />
    </StackPanel>

    <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="330" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" MinWidth="330" />
      </Grid.ColumnDefinitions>

      <!-- Left: what to include, and which clips -->
      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Top" Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="INCLUDE" />
          <CheckBox Margin="0,0,0,6" IsChecked="{Binding SkeletonOnly, Mode=TwoWay}" IsEnabled="{Binding HasSkeleton}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Leave the geometry out: the file holds the skeleton (and the spheres, prop points and animations you choose)"
                    AutomationProperties.Name="Skeleton only">
            <AccessText Text="_Skeleton only (no geometry)" />
          </CheckBox>
          <ItemsControl ItemsSource="{Binding Lods}" Focusable="False" Margin="18,0,0,4" IsEnabled="{Binding IncludeMesh}"
                        AutomationProperties.Name="Levels of detail">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="0,0,16,6" IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.Name="{Binding AutomationName}"
                          ToolTip="Export this level of detail as its own glTF mesh ({submesh}_LOD{n})">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding Note}" Margin="6,0,0,0" FontSize="11" Foreground="{DynamicResource App.SecondaryText}" VerticalAlignment="Center" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel>
            <CheckBox Margin="0,0,16,6" IsChecked="{Binding IncludeSpheres, Mode=TwoWay}" Content="{Binding SpheresLabel}"
                      ToolTip="Collision spheres as rf_csphere:: nodes on their bones (scale = radius), as REDUX writes them"
                      AutomationProperties.Name="Collision spheres" />
            <CheckBox Margin="0,0,16,6" IsChecked="{Binding IncludeProps, Mode=TwoWay}" Content="{Binding PropsLabel}"
                      ToolTip="Prop points as rf_prop:: nodes on their bones, as REDUX writes them"
                      AutomationProperties.Name="Prop points" />
            <CheckBox Margin="0,0,0,6" IsChecked="{Binding IncludeTextures, Mode=TwoWay}" IsEnabled="{Binding CanIncludeTextures}"
                      ToolTipService.ShowOnDisabled="True" ToolTip="{Binding TexturesToolTip}" AutomationProperties.Name="Textures">
              <AccessText Text="_Textures (as PNG)" />
            </CheckBox>
          </WrapPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Style="{StaticResource DialogSubheading}" Text="ANIMATIONS" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HintText}" Margin="0,0,0,6" Text="{Binding ClipsHint}" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="6,0,0,0" Content="_None" Command="{Binding ClearClipsCommand}"
                  ToolTip="Untick every clip (the clip being exported stays)" AutomationProperties.Name="Untick every clip" />
          <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="6,0,0,0" Content="Tick s_hown" Command="{Binding CheckAllClipsCommand}"
                  ToolTip="Tick every clip the filter shows" AutomationProperties.Name="Tick every shown clip" />
          <TextBox MinHeight="26" VerticalContentAlignment="Center" Text="{Binding Clips.Filter, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Filter the clips by name (substring, or * and ? wildcards)" AutomationProperties.Name="Filter clips" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource App.SecondaryText}" Text="{Binding ClipsSummary}"
                   TextWrapping="Wrap" AutomationProperties.Name="Clips summary" />
        <ListBox Style="{StaticResource PickList}" ItemsSource="{Binding Clips.Items}" MinHeight="120" AutomationProperties.Name="Clips to export">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="6,2" />
              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel ToolTip="{Binding ToolTip}">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Margin="12,0,10,0" FontSize="11"
                           Foreground="{DynamicResource App.SecondaryText}" VerticalAlignment="Center" />
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding AutomationName}">
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                </CheckBox>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Right: format, key extras, output, result -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,6,0">
        <StackPanel>
          <StackPanel Style="{StaticResource DialogGroup}">
            <TextBlock Style="{StaticResource DialogSubheading}" Text="FORMAT" />
            <RadioButton GroupName="Format" Margin="0,0,0,2" IsChecked="{Binding IsGltf, Mode=TwoWay}"
                         ToolTip="{Binding GltfFormatText}" AutomationProperties.Name="glTF with separate files">
              <AccessText Text=".gltf + ._bin + PNG textures" />
            </RadioButton>
            <TextBlock Style="{StaticResource HintText}" Margin="22,0,0,8" Text="{Binding GltfFormatText}" />
            <RadioButton GroupName="Format" Margin="0,0,0,2" IsChecked="{Binding IsGlb, Mode=TwoWay}"
                         ToolTip="{Binding GlbFormatText}" AutomationProperties.Name="Single glb file">
              <AccessText Text="Single ._glb" />
            </RadioButton>
            <TextBlock Style="{StaticResource HintText}" Margin="22,0,0,0" Text="{Binding GlbFormatText}" />
          </StackPanel>

          <StackPanel Style="{StaticResource DialogGroup}">
            <TextBlock Style="{StaticResource DialogSubheading}" Text="KEY EXTRAS" />
            <CheckBox Margin="0,0,0,4" IsChecked="{Binding WriteKeyExtras, Mode=TwoWay}"
                      ToolTip="Store each clip's raw RF keys (rf_keys) beside the glTF keys, so an unedited round trip is exact"
                      AutomationProperties.Name="Write key extras">
              <AccessText Text="Write RF _key extras (rf__keys)" />
            </CheckBox>
            <TextBlock Style="{StaticResource HintText}" Margin="22,0,0,4" Text="{Binding KeyExtrasRoundTripText}" AutomationProperties.Name="Round trip" />
            <TextBlock Style="{StaticResource HintText}" Margin="22,0,0,0" Text="{Binding KeyExtrasReduxText}" AutomationProperties.Name="REDUX" />
          </StackPanel>

          <StackPanel Style="{StaticResource DialogGroup}">
            <TextBlock Style="{StaticResource DialogSubheading}" Text="OUTPUT" />
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="8,0,0,0" Content="Bro_wse…" Command="{Binding BrowseCommand}"
                      ToolTip="Choose where to write the file (never the game folder)" AutomationProperties.Name="Browse for the output file" />
              <TextBox x:Name="PathBox" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="The file to write (.gltf or .glb)" AutomationProperties.Name="Output file" />
            </DockPanel>
            <TextBlock Style="{StaticResource HintText}" Text="{Binding FilesText, StringFormat='Writes {0}.'}" AutomationProperties.Name="Files that will be written" />
          </StackPanel>

          <StackPanel Visibility="{Binding HasResult, Converter={StaticResource Truthy}}">
            <TextBlock Style="{StaticResource DialogSubheading}" Text="RESULT" />
            <Border Style="{StaticResource DialogCard}" Padding="10,8" AutomationProperties.Name="Export result">
              <ItemsControl ItemsSource="{Binding ResultLines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1">
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,7,0"
                                 Foreground="{Binding BrushKey, Converter={StaticResource BrushKey}}" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}"
                                 AutomationProperties.Name="{Binding Text}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Problems, errors and progress -->
    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.SecondaryText}" Text="{Binding Problem}"
                 Visibility="{Binding Problem, Converter={StaticResource Truthy}}" AutomationProperties.Name="Why Export is disabled" />
      <DockPanel Visibility="{Binding HasError, Converter={StaticResource Truthy}}">
        <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,7,0" Foreground="{DynamicResource Severity.Error}" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Severity.Error}" AutomationProperties.Name="Export error" />
      </DockPanel>
      <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding IsExporting}"
                   Visibility="{Binding IsExporting, Converter={StaticResource Truthy}}" AutomationProperties.Name="Export progress" />
      <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="{Binding ProgressText}"
                 Visibility="{Binding ProgressText, Converter={StaticResource Truthy}}" AutomationProperties.Name="Export progress detail" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource DialogButton}" Content="_Export" IsDefault="True" Command="{Binding ExportCommand}"
              Visibility="{Binding IsIdle, Converter={StaticResource Truthy}}" ToolTipService.ShowOnDisabled="True"
              ToolTip="Write the glTF file (the dialog stays open and shows what was written)" AutomationProperties.Name="Export" />
      <Button Style="{StaticResource DialogButton}" Content="_Stop" Command="{Binding StopCommand}"
              Visibility="{Binding IsExporting, Converter={StaticResource Truthy}}"
              ToolTip="Stop the export; nothing is written once it has stopped" AutomationProperties.Name="Stop the export" />
      <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True"
              ToolTip="Close the dialog (Esc); a running export is stopped first" AutomationProperties.Name="Close" />
    </StackPanel>
  </Grid>
</Window>
