<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared by the glTF dialogs (export, import animation, import mesh). Theme brushes only. -->

  <!-- A picker list (library entries, clips, animations). -->
  <Style x:Key="PickList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="Background" Value="{DynamicResource App.PaneBackground}" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="6,2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An entry with a name and a dimmed note on the right. -->
  <DataTemplate x:Key="PickEntryTemplate">
    <DockPanel ToolTip="{Binding ToolTip}">
      <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Margin="12,0,10,0" FontSize="11"
                 Foreground="{DynamicResource App.SecondaryText}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" />
    </DockPanel>
  </DataTemplate>

  <!-- A label in front of an option's field. -->
  <Style x:Key="OptionLabel" TargetType="TextBlock" BasedOn="{StaticResource DialogLabel}">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Width" Value="128" />
  </Style>

  <!-- The plain-language line under an option. -->
  <Style x:Key="OptionHint" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
    <Setter Property="Margin" Value="0,2,0,10" />
  </Style>

  <Style x:Key="OptionRow" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
  </Style>
</ResourceDictionary>
