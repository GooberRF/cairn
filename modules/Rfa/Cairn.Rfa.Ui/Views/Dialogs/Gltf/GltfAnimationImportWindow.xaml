<Window x:Class="Cairn.Rfa.Ui.Views.Dialogs.Gltf.GltfAnimationImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cui="clr-namespace:Cairn.Ui.Controls;assembly=Cairn.Ui" xmlns:cv="clr-namespace:Cairn.Viewport;assembly=Cairn.Viewport"
        xmlns:controls="clr-namespace:Cairn.Rfa.Ui.Controls"
        xmlns:viewport="clr-namespace:Cairn.Rfa.Ui.Viewport"
        xmlns:retarget="clr-namespace:Cairn.Rfa.Ui.Views.Retarget"
        Title="{Binding Title}" Width="1280" Height="880" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- File › Import Animation from glTF… (GltfAnimationImportViewModel). Theme brushes only. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GltfDialogResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Style="{StaticResource DialogHeading}" Text="{Binding Heading}" />
      <TextBlock Style="{StaticResource HintText}" Text="{Binding Description}" />
      <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource App.Text}" Text="{Binding SourceSummary}"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" AutomationProperties.Name="What the file holds" />
    </StackPanel>

    <Grid Grid.Row="1" IsEnabled="{Binding IsIdle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="420" MinWidth="340" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="600" />
      </Grid.ColumnDefinitions>

      <!-- Left: animations, target, options -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
        <StackPanel>
          <StackPanel Style="{StaticResource DialogGroup}">
            <TextBlock Style="{StaticResource DialogSubheading}" Text="ANIMATIONS" />
            <ListBox x:Name="AnimationList" Style="{StaticResource PickList}" Height="132" ItemsSource="{Binding Animations}"
                     SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}" AutomationProperties.Name="Animations in the file"
                     ToolTip="Tick the animations to import (one clip each); the selected one is previewed">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="6,2" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel ToolTip="{Binding ToolTip}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Margin="12,0,10,0" FontSize="11"
                               Foreground="{DynamicResource App.SecondaryText}" VerticalAlignment="Center" />
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                    </CheckBox>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="{Binding AnimationsSummary}" AutomationProperties.Name="Animations summary" />
          </StackPanel>

          <StackPanel Style="{StaticResource DialogGroup}">
            <TextBlock Style="{StaticResource DialogSubheading}" Text="TARGET MESH" />
            <TextBlock FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource App.Text}" Text="{Binding TargetText}" AutomationProperties.Name="Target mesh" />
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="6,0,0,0" Content="_Browse…" Command="{Binding BrowseTargetCommand}"
                      ToolTip="Use a .v3c file that is not open or in the library" AutomationProperties.Name="Browse for a target mesh" />
              <TextBox MinHeight="26" VerticalContentAlignment="Center" Text="{Binding Targets.Filter, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Filter the meshes by name (substring, or * and ? wildcards)" AutomationProperties.Name="Filter target meshes" />
            </DockPanel>
            <ListBox Style="{StaticResource PickList}" Height="140" ItemsSource="{Binding Targets.Items}" SelectedItem="{Binding Targets.Selected, Mode=TwoWay}"
                     ItemTemplate="{StaticResource PickEntryTemplate}" AutomationProperties.Name="Target meshes"
                     ToolTip="The mesh the clips are made for: open tabs first (a clip tab offers its preview mesh), then the library's characters" />
          </StackPanel>

          <StackPanel Style="{StaticResource DialogGroup}">
            <TextBlock Style="{StaticResource DialogSubheading}" Text="OPTIONS" />
            <Border Style="{StaticResource DialogCard}" Padding="8,6" Margin="0,0,0,10" Visibility="{Binding HasRfExtras, Converter={StaticResource Truthy}}">
              <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.Text}" AutomationProperties.Name="RF extras note"
                         Text="This animation carries RF header extras: its start, end, ramps, weights and version come from the file. The defaults below apply only where it has none." />
            </Border>

            <TextBlock Style="{StaticResource DialogLabel}" Text="Reference clip" Margin="0,0,0,4" />
            <TextBox MinHeight="26" Margin="0,0,0,4" VerticalContentAlignment="Center" Text="{Binding References.Filter, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter the clips by name (substring, or * and ? wildcards)" AutomationProperties.Name="Filter reference clips" />
            <ListBox Style="{StaticResource PickList}" Height="100" ItemsSource="{Binding References.Items}" SelectedItem="{Binding References.Selected, Mode=TwoWay}"
                     ItemTemplate="{StaticResource PickEntryTemplate}" AutomationProperties.Name="Reference clips"
                     ToolTip="Clips with the target's bone count; the character's stand clip is first" />
            <TextBlock Style="{StaticResource OptionHint}" Text="Bones the file has no node for hold this clip's first pose (usually the character's stand clip), or the bind pose." />

            <StackPanel Style="{StaticResource OptionRow}">
              <TextBlock Style="{StaticResource OptionLabel}" Text="Bone weight" />
              <cui:NumericBox Width="110" Value="{Binding DefaultWeight, Mode=TwoWay}" Decimals="2" Step="1" Minimum="0" Maximum="100"
                                   ToolTip="Each bone's blend weight when the file has no rf_weight" AutomationProperties.Name="Default bone weight" />
            </StackPanel>
            <TextBlock Style="{StaticResource OptionHint}" Text="How strongly the clip overrides others when the game blends (stock clips mostly use 10; REDUX uses 10). Used only where the file has no rf_weight." />

            <StackPanel Style="{StaticResource OptionRow}">
              <TextBlock Style="{StaticResource OptionLabel}" Text="Start at" />
              <cui:NumericBox Width="110" Value="{Binding StartTime, Mode=TwoWay}" Decimals="{Binding UnitDecimals}" Suffix="{Binding UnitSuffix}"
                                   Step="{Binding UnitStep}" Minimum="0" ToolTip="Where the first key lands when the file has no rf_start_time"
                                   AutomationProperties.Name="Start time" />
            </StackPanel>
            <TextBlock Style="{StaticResource OptionHint}" Text="Where the first glTF key lands when the file carries no start time. Stock clips start at frame 1." />

            <StackPanel Style="{StaticResource OptionRow}">
              <TextBlock Style="{StaticResource OptionLabel}" Text="Sample every" />
              <cui:NumericBox Width="110" Value="{Binding SampleStep, Mode=TwoWay}" Decimals="{Binding UnitDecimals}" Suffix="{Binding UnitSuffix}"
                                   Step="{Binding UnitStep}" Minimum="{Binding MinimumStep}" ToolTip="The resampling step for bones whose keys cannot be kept"
                                   AutomationProperties.Name="Sample step" />
            </StackPanel>
            <TextBlock Style="{StaticResource OptionHint}" Text="Bones whose node hangs differently from the target bone are resampled at this step (1 frame = 30 samples a second). Smaller is closer but bigger." />

            <StackPanel Style="{StaticResource OptionRow}" Margin="0,0,0,2">
              <TextBlock Style="{StaticResource OptionLabel}" Text="RFA version" />
              <RadioButton GroupName="Version" Margin="0,0,16,0" VerticalAlignment="Center" IsChecked="{Binding IsVersion8, Mode=TwoWay}"
                           ToolTip="Version 8: what most stock clips use" AutomationProperties.Name="Version 8">
                <AccessText Text="_8" />
              </RadioButton>
              <RadioButton GroupName="Version" VerticalAlignment="Center" IsChecked="{Binding IsVersion7, Mode=TwoWay}"
                           ToolTip="Version 7: the older layout" AutomationProperties.Name="Version 7">
                <AccessText Text="_7" />
              </RadioButton>
            </StackPanel>
            <TextBlock Style="{StaticResource OptionHint}" Text="The clip file's version when the file has no rf_version. Both play the same; 8 is the usual one." />

            <StackPanel Style="{StaticResource OptionRow}" Margin="0,0,0,4">
              <TextBlock Style="{StaticResource OptionLabel}" Text="Ramp in" />
              <cui:NumericBox Width="110" Value="{Binding RampIn, Mode=TwoWay}" Decimals="{Binding UnitDecimals}" Suffix="{Binding UnitSuffix}"
                                   Step="{Binding UnitStep}" Minimum="0" ToolTip="Blend-in time when the file has none" AutomationProperties.Name="Ramp in" />
            </StackPanel>
            <StackPanel Style="{StaticResource OptionRow}">
              <TextBlock Style="{StaticResource OptionLabel}" Text="Ramp out" />
              <cui:NumericBox Width="110" Value="{Binding RampOut, Mode=TwoWay}" Decimals="{Binding UnitDecimals}" Suffix="{Binding UnitSuffix}"
                                   Step="{Binding UnitStep}" Minimum="0" ToolTip="Blend-out time when the file has none" AutomationProperties.Name="Ramp out" />
            </StackPanel>
            <TextBlock Style="{StaticResource OptionHint}" Text="How long the game fades the clip in and out over whatever was playing. Used only where the file carries no ramps." />

            <CheckBox Margin="0,0,0,4" IsChecked="{Binding Reduce, Mode=TwoWay}" ToolTip="Remove keys the motion does not need, within the tolerances"
                      AutomationProperties.Name="Reduce keys">
              <AccessText Text="_Reduce keys" />
            </CheckBox>
            <StackPanel Margin="22,0,0,0" IsEnabled="{Binding Reduce}">
              <StackPanel Style="{StaticResource OptionRow}" Margin="0,0,0,4">
                <TextBlock Style="{StaticResource OptionLabel}" Width="106" Text="Rotation within" />
                <cui:NumericBox Width="110" Value="{Binding RotationTolerance, Mode=TwoWay}" Decimals="3" Step="0.05" Minimum="0" Suffix="°"
                                     ToolTip="Largest rotation change a removed key may cause" AutomationProperties.Name="Rotation tolerance" />
              </StackPanel>
              <StackPanel Style="{StaticResource OptionRow}">
                <TextBlock Style="{StaticResource OptionLabel}" Width="106" Text="Position within" />
                <cui:NumericBox Width="110" Value="{Binding PositionTolerance, Mode=TwoWay}" Decimals="4" Step="0.0005" Minimum="0" Suffix="m"
                                     ToolTip="Largest position change a removed key may cause" AutomationProperties.Name="Position tolerance" />
              </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource OptionHint}" Text="Makes converted or resampled tracks smaller by dropping keys that change the pose by less than this. Tracks restored exactly from key extras are never reduced." />

            <CheckBox Margin="0,0,0,4" IsChecked="{Binding UseKeyExtras, Mode=TwoWay}"
                      ToolTip="Restore tracks from the rf_keys extras while they still match the glTF motion" AutomationProperties.Name="Use key extras">
              <AccessText Text="Use RF _key extras when present" />
            </CheckBox>
            <TextBlock Style="{StaticResource OptionHint}" Text="An RFA Workbench export stores the original keys: with this on, an unedited animation comes back exactly as it was. Off: the glTF keys are converted instead." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" Margin="4,0" AutomationProperties.Name="Resize the options" />

      <!-- Right: preview, bone map, report -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="200" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="1.25*" MinHeight="230" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" BorderBrush="{DynamicResource App.Border}" CornerRadius="3" ClipToBounds="True">
          <Grid>
            <viewport:ViewportControl DataContext="{Binding Preview}" AutomationProperties.Name="Preview of the imported clip" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,8" CornerRadius="4" MaxWidth="440"
                    Background="{DynamicResource Viewport.Notice}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                    Visibility="{Binding HasPreviewMessage, Converter={StaticResource Truthy}}" IsHitTestVisible="False">
              <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Viewport.NoticeText}"
                         AutomationProperties.Name="Preview message" />
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="7,2" CornerRadius="3"
                    Background="{DynamicResource Viewport.LabelBackground}" IsHitTestVisible="False"
                    Visibility="{Binding IsBusy, Converter={StaticResource Truthy}}">
              <TextBlock Text="Working…" FontSize="11" Foreground="{DynamicResource Viewport.Label}" />
            </Border>
          </Grid>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
          <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" MinWidth="32" Margin="0,0,6,0" VerticalAlignment="Center"
                  Command="{Binding Playback.PlayPauseCommand}" ToolTip="Play or pause the preview" AutomationProperties.Name="Play or pause the preview">
            <TextBlock Text="{Binding Playback.PlayGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
          </Button>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Playback.TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="90" TextAlignment="Right"
                     Foreground="{DynamicResource App.SecondaryText}" AutomationProperties.Name="Preview time" />
          <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource App.ChromeBackground}">
            <cv:TimeScrubber DataContext="{Binding Playback}" Margin="0,1" />
          </Border>
        </DockPanel>
        <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="0,4,0,6" Text="{Binding ReportSummary}" TextWrapping="Wrap"
                   AutomationProperties.Name="Import summary" />

        <TabControl Grid.Row="3" Style="{StaticResource PanelTabControl}" AutomationProperties.Name="Bone map and report">
          <TabItem Header="Bone map" ToolTip="Which glTF node drives each bone of the target (edit a row to change it)">
            <retarget:BoneMapTable DataContext="{Binding BoneMap}" Margin="0,6,0,0" />
          </TabItem>
          <TabItem Header="Report" ToolTip="How each bone's track was made, and the importer's notes">
            <DockPanel Margin="0,6,0,0">
              <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Warnings}" Margin="0,6,0,0" Focusable="False" AutomationProperties.Name="Import notes">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,1">
                      <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,7,0" Foreground="{DynamicResource Severity.Warning}" />
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border BorderThickness="1" BorderBrush="{DynamicResource App.Border}" Background="{DynamicResource App.PaneBackground}" CornerRadius="3">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" Background="{DynamicResource Table.HeaderBackground}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="118" />
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="#" Margin="8,4" />
                    <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="Bone" Margin="4,4" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="glTF node" Margin="4,4" />
                    <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="Made by" Margin="4,4" />
                    <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="Rotation keys" Margin="4,4" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderText}" Text="Position keys" Margin="4,4,10,4" TextAlignment="Right" />
                  </Grid>
                  <ListBox ItemsSource="{Binding ReportRows}" BorderThickness="0" Background="Transparent"
                           VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Per-bone report">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,1" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding BoneName}" />
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="86" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding IndexText}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource App.SecondaryText}" />
                          <TextBlock Grid.Column="1" Text="{Binding BoneName}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                     Foreground="{DynamicResource App.Text}" ToolTip="{Binding BoneName}" />
                          <TextBlock Grid.Column="2" Text="{Binding Source}" Margin="4,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                     Foreground="{DynamicResource App.Text}" ToolTip="{Binding Source}" />
                          <Border Grid.Column="3" Margin="4,2" Padding="6,1" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Background="{Binding ModeBrushKey, Converter={StaticResource BrushKey}}" ToolTip="{Binding ModeToolTip}">
                            <TextBlock Text="{Binding ModeText}" FontSize="11" Foreground="{DynamicResource App.Text}" />
                          </Border>
                          <TextBlock Grid.Column="4" Text="{Binding RotationText}" Margin="4,0" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource App.Text}" />
                          <TextBlock Grid.Column="5" Text="{Binding PositionText}" Margin="4,0,10,0" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                     Foreground="{DynamicResource App.Text}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.SecondaryText}" Text="{Binding Problem}"
                 Visibility="{Binding Problem, Converter={StaticResource Truthy}}" AutomationProperties.Name="Why Import is disabled" />
      <DockPanel Visibility="{Binding HasError, Converter={StaticResource Truthy}}">
        <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,7,0" Foreground="{DynamicResource Severity.Error}" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Severity.Error}" AutomationProperties.Name="Import error" />
      </DockPanel>
      <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding IsImporting}"
                   Visibility="{Binding IsImporting, Converter={StaticResource Truthy}}" AutomationProperties.Name="Import progress" />
      <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="{Binding ProgressText}"
                 Visibility="{Binding ProgressText, Converter={StaticResource Truthy}}" AutomationProperties.Name="Import progress detail" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Style="{StaticResource DialogButton}" Content="_Import" IsDefault="True" Command="{Binding ImportCommand}"
              Visibility="{Binding IsIdle, Converter={StaticResource Truthy}}" ToolTipService.ShowOnDisabled="True"
              ToolTip="Open each ticked animation as a new, unsaved clip on the target mesh (nothing is written until you save)"
              AutomationProperties.Name="Import" />
      <Button Style="{StaticResource DialogButton}" Content="_Stop" Command="{Binding StopCommand}"
              Visibility="{Binding IsImporting, Converter={StaticResource Truthy}}"
              ToolTip="Stop the import; no clips are opened" AutomationProperties.Name="Stop the import" />
      <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True"
              ToolTip="Close without importing (Esc)" AutomationProperties.Name="Cancel" />
    </StackPanel>
  </Grid>
</Window>
