<Window x:Class="Cairn.Rfa.Ui.Views.Dialogs.ClipTools.ClipToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cv="clr-namespace:Cairn.Viewport;assembly=Cairn.Viewport"
        xmlns:controls="clr-namespace:Cairn.Rfa.Ui.Controls"
        Title="{Binding Title}" Width="600" SizeToContent="Height" MinWidth="500" MinHeight="320" MaxHeight="940"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ClipToolTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,18,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- What the tool does -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource DialogHeading}" Text="{Binding Heading}" />
      <TextBlock Style="{StaticResource HintText}" Text="{Binding Description}" />
    </StackPanel>

    <!-- Scope and the tool's own settings -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                  Padding="0,0,6,0">
      <StackPanel>
        <StackPanel Style="{StaticResource DialogGroup}" Visibility="{Binding SupportsBoneScope, Converter={StaticResource Truthy}}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="BONES" />
          <WrapPanel>
            <RadioButton GroupName="BoneScope" Margin="0,0,16,6" IsChecked="{Binding IsScopeAll, Mode=TwoWay}"
                         ToolTip="Work on every bone of the clip" AutomationProperties.Name="Every bone">
              <AccessText Text="_Every bone" />
            </RadioButton>
            <RadioButton GroupName="BoneScope" Margin="0,0,16,6" IsChecked="{Binding IsScopeSelected, Mode=TwoWay}"
                         IsEnabled="{Binding HasSelectedBones}" Content="{Binding SelectedBonesLabel}"
                         ToolTipService.ShowOnDisabled="True"
                         ToolTip="Only the bones selected in the viewport (select them before opening this dialog)"
                         AutomationProperties.Name="Selected bones" />
            <RadioButton GroupName="BoneScope" Margin="0,0,0,6" IsChecked="{Binding IsScopeKeys, Mode=TwoWay}"
                         IsEnabled="{Binding HasKeyBones}" Content="{Binding KeyBonesLabel}"
                         ToolTipService.ShowOnDisabled="True"
                         ToolTip="Only the bones that own a selected key (select keys in the timeline before opening this dialog)"
                         AutomationProperties.Name="Bones with selected keys" />
          </WrapPanel>
        </StackPanel>

        <ContentControl x:Name="ToolContent" Content="{Binding}" Focusable="False" IsTabStop="False" />
      </StackPanel>
    </ScrollViewer>

    <!-- What will change -->
    <StackPanel Grid.Row="2" Margin="0,4,0,0">
      <TextBlock Style="{StaticResource DialogSubheading}" Text="WHAT WILL CHANGE" />
      <Border Style="{StaticResource DialogCard}" Padding="10,8" MinHeight="44" AutomationProperties.Name="What will change">
        <StackPanel>
          <TextBlock Style="{StaticResource HintText}" Text="Working out the result…"
                     Visibility="{Binding IsBusy, Converter={StaticResource Truthy}}" AutomationProperties.Name="Working" />
          <ItemsControl ItemsSource="{Binding SummaryLines}" Focusable="False" AutomationProperties.Name="Summary">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,1">
                  <TextBlock DockPanel.Dock="Left" Text="•" Margin="0,0,7,0" Foreground="{DynamicResource App.SecondaryText}" />
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="0,2,0,0" Visibility="{Binding HasError, Converter={StaticResource Truthy}}">
            <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,7,0"
                       Foreground="{DynamicResource Severity.Error}" />
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Severity.Error}"
                       AutomationProperties.Name="Why this cannot be applied" />
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Watch the preview: the document's transport -->
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" MinWidth="32" Margin="0,0,6,0" VerticalAlignment="Center"
                Command="{Binding Playback.PlayPauseCommand}" ToolTip="Play or pause the preview in the viewport"
                AutomationProperties.Name="Play or pause the preview">
          <TextBlock Text="{Binding Playback.PlayGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" />
        </Button>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Playback.TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                   Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="90" TextAlignment="Right"
                   Foreground="{DynamicResource App.SecondaryText}" AutomationProperties.Name="Preview time" />
        <Border BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource App.ChromeBackground}">
          <cv:TimeScrubber DataContext="{Binding Playback}" Margin="0,1" />
        </Border>
      </DockPanel>
      <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="{Binding PreviewHint}" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource DialogButton}" Content="{Binding ApplyText}" IsDefault="True" Click="OnOk"
              IsEnabled="{Binding CanApply}" ToolTip="{Binding ApplyToolTip}" ToolTipService.ShowOnDisabled="True"
              AutomationProperties.Name="{Binding ApplyText}" />
      <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True"
              ToolTip="Close without changing anything (Esc)" AutomationProperties.Name="Cancel" />
    </StackPanel>
  </Grid>
</Window>
