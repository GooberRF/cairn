<Window x:Class="Cairn.Rfa.Ui.Views.Dialogs.Obj.ObjExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="780" Height="720" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- File › Export › OBJ… and Convert to › OBJ (ObjExportViewModel). Theme brushes only. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Cairn.Rfa.Ui;component/Views/Dialogs/Gltf/GltfDialogResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,18,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource DialogHeading}" Text="{Binding Heading}" />
      <TextBlock Style="{StaticResource HintText}" Text="{Binding Description}" />
      <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource App.Text}" Text="{Binding SourceSummary}"
                 TextWrapping="Wrap" AutomationProperties.Name="What is exported" />
      <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Severity.Warning}" Text="{Binding CharacterNote}"
                 Visibility="{Binding CharacterNote, Converter={StaticResource Truthy}}" AutomationProperties.Name="What OBJ cannot carry" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,6,0">
      <StackPanel IsEnabled="{Binding IsIdle}">
        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="INCLUDE" />
          <StackPanel Style="{StaticResource OptionRow}" Margin="0,0,0,4" Visibility="{Binding HasLodChoice, Converter={StaticResource Truthy}}">
            <TextBlock Style="{StaticResource OptionLabel}" Text="Level of detail" />
            <ComboBox x:Name="LodBox" MinWidth="340" MinHeight="26" ItemsSource="{Binding LodChoices}" SelectedItem="{Binding Lod, Mode=TwoWay}"
                      ToolTip="Which level of detail to write: one LOD as one object per submesh, or every LOD, each as its own object"
                      AutomationProperties.Name="Level of detail" />
          </StackPanel>
          <TextBlock Style="{StaticResource OptionHint}" Visibility="{Binding HasLodChoice, Converter={StaticResource Truthy}}"
                     Text="3D tools show every object at once, so LOD 0 alone is usually what you want to edit." />
          <CheckBox Margin="0,0,0,4" IsChecked="{Binding IncludeTextures, Mode=TwoWay}" IsEnabled="{Binding CanIncludeTextures}"
                    ToolTipService.ShowOnDisabled="True" ToolTip="{Binding TexturesToolTip}" AutomationProperties.Name="Textures">
            <AccessText Text="_Textures (as PNG beside the .obj)" />
          </CheckBox>
          <TextBlock Style="{StaticResource OptionHint}" Margin="22,0,0,10" Text="{Binding TexturesToolTip}" />
          <CheckBox Margin="0,0,0,4" IsChecked="{Binding WriteMetadata, Mode=TwoWay}"
                    ToolTip="Write Cairn's rf_ comment lines, which other tools ignore" AutomationProperties.Name="Write Cairn's metadata">
            <AccessText Text="Write Cairn's _metadata lines" />
          </CheckBox>
          <TextBlock Style="{StaticResource OptionHint}" Margin="22,0,0,0" Text="{Binding MetadataText}" AutomationProperties.Name="What the metadata keeps" />
        </StackPanel>

        <StackPanel Style="{StaticResource DialogGroup}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="OUTPUT" />
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="8,0,0,0" Content="Bro_wse…" Command="{Binding BrowseCommand}"
                    ToolTip="Choose where to write the file (never the game folder)" AutomationProperties.Name="Browse for the output file" />
            <TextBox x:Name="PathBox" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="The .obj file to write; the .mtl and textures go beside it" AutomationProperties.Name="Output file" />
          </DockPanel>
          <TextBlock Style="{StaticResource HintText}" Text="{Binding FilesText, StringFormat='Writes {0}.'}" AutomationProperties.Name="Files that will be written" />
        </StackPanel>

        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource Truthy}}">
          <TextBlock Style="{StaticResource DialogSubheading}" Text="RESULT" />
          <Border Style="{StaticResource DialogCard}" Padding="10,8" AutomationProperties.Name="Export result">
            <ItemsControl ItemsSource="{Binding ResultLines}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,1">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,7,0"
                               Foreground="{Binding BrushKey, Converter={StaticResource BrushKey}}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}"
                               AutomationProperties.Name="{Binding Text}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,10,0,0">
      <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.SecondaryText}" Text="{Binding Problem}"
                 Visibility="{Binding Problem, Converter={StaticResource Truthy}}" AutomationProperties.Name="Why Export is disabled" />
      <DockPanel Visibility="{Binding HasError, Converter={StaticResource Truthy}}">
        <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,7,0" Foreground="{DynamicResource Severity.Error}" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Severity.Error}" AutomationProperties.Name="Export error" />
      </DockPanel>
      <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding IsExporting}"
                   Visibility="{Binding IsExporting, Converter={StaticResource Truthy}}" AutomationProperties.Name="Export progress" />
      <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="{Binding ProgressText}"
                 Visibility="{Binding ProgressText, Converter={StaticResource Truthy}}" AutomationProperties.Name="Export progress detail" />
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource DialogButton}" Content="_Export" IsDefault="True" Command="{Binding ExportCommand}" ToolTipService.ShowOnDisabled="True"
              ToolTip="Write the .obj, its .mtl and the textures (the dialog stays open and shows what was written)" AutomationProperties.Name="Export" />
      <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True"
              ToolTip="Close the dialog (Esc)" AutomationProperties.Name="Close" />
    </StackPanel>
  </Grid>
</Window>
