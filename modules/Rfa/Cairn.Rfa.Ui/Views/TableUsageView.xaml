<UserControl x:Class="Cairn.Rfa.Ui.Views.TableUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Cairn.Rfa.Ui.ViewModels">
  <UserControl.Resources>
    <!-- The row menu: the TreeViewItem's Tag carries the panel's view-model, its DataContext the row. -->
    <ContextMenu x:Key="RowMenu" x:Shared="False">
      <MenuItem Header="{Binding PrimaryActionHeader}" FontWeight="SemiBold"
                Visibility="{Binding HasPrimaryAction, Converter={StaticResource Truthy}}"
                Command="{Binding PlacementTarget.Tag.ActivateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding}" ToolTip="The double-click action (Enter)" />
      <MenuItem Header="_Preview on this mesh" Visibility="{Binding HasPreviewAction, Converter={StaticResource Truthy}}"
                Command="{Binding PlacementTarget.Tag.PreviewClipCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding}" ToolTipService.ShowOnDisabled="True"
                ToolTip="Play this clip on the mesh document without opening it" />
      <Separator Visibility="{Binding HasPrimaryAction, Converter={StaticResource Truthy}}" />
      <MenuItem Header="_Copy table line" InputGestureText="Ctrl+C"
                Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                CommandParameter="{Binding}" ToolTip="Copy this line (or this list's block) in the chosen table layout" />
    </ContextMenu>

    <Style x:Key="LayoutChoice" TargetType="RadioButton" BasedOn="{StaticResource SegmentButton}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="7,0" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Summary, layout choice, copy -->
    <Border Grid.Row="0" Background="{DynamicResource App.PaneBackground}" BorderBrush="{DynamicResource App.SubtleBorder}"
            BorderThickness="0,0,0,1" Padding="8,3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="Layout" Style="{StaticResource PaneHeaderText}" FontWeight="Normal" Margin="0,0,6,0" />
          <Border BorderBrush="{DynamicResource App.SubtleBorder}" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource LayoutChoice}" Content="entity.tbl" IsChecked="{Binding IsEntityStyle, Mode=TwoWay}"
                           ToolTip="Copy lines in entity.tbl's layout (tab indent, aligned columns)"
                           AutomationProperties.Name="entity.tbl layout" />
              <RadioButton Style="{StaticResource LayoutChoice}" Content="weapons.tbl" IsChecked="{Binding IsWeaponStyle, Mode=TwoWay}"
                           ToolTip="Copy lines in weapons.tbl's layout (no indent, columns sized to the values)"
                           AutomationProperties.Name="weapons.tbl layout" />
            </StackPanel>
          </Border>
          <Button Style="{StaticResource ToolButton}" Height="24" Padding="7,0" Command="{Binding CopyCommand}"
                  ToolTip="{Binding CopyToolTip}" AutomationProperties.Name="Copy table line">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="Copy table line" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding Summary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource App.Text}" ToolTip="{Binding Summary}" AutomationProperties.Name="Table usage summary" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent" Padding="2,3"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                MouseDoubleClick="OnTreeDoubleClick" KeyDown="OnTreeKeyDown"
                Visibility="{Binding IsEmpty, Converter={StaticResource Falsy}}"
                AutomationProperties.Name="Table usage">
        <TreeView.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource PaneScrollBar}" />
        </TreeView.Resources>
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource PaneTreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ItemTemplate>
          <HierarchicalDataTemplate DataType="{x:Type vm:TableUsageNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="18"
                         VerticalAlignment="Center" Foreground="{DynamicResource App.SecondaryText}" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource App.Text}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="Group">
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="FontWeight" Value="SemiBold" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Subtitle}" VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0"
                         Foreground="{DynamicResource App.SecondaryText}" />
              <Border Style="{StaticResource BadgeBorder}" Margin="8,0,2,0" Visibility="{Binding Badge, Converter={StaticResource Truthy}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Severity.Warning}"
                             Visibility="{Binding IsWarning, Converter={StaticResource Truthy}}" />
                  <TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <!-- Empty states: no tables, an unused clip, a mesh no class uses -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,12" MaxWidth="760"
                  Visibility="{Binding IsEmpty, Converter={StaticResource Truthy}}">
        <TextBlock Style="{StaticResource HintText}" TextAlignment="Center" Text="{Binding EmptyText}"
                   AutomationProperties.Name="{Binding EmptyText}" />
        <Button Margin="0,10,0,0" Padding="12,4" HorizontalAlignment="Center" Command="{Binding SettingsCommand}"
                Visibility="{Binding OffersSettings, Converter={StaticResource Truthy}}"
                ToolTip="Set the game directory and search folders" AutomationProperties.Name="Open settings">
          <AccessText Text="_Settings…" />
        </Button>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding SourcesText}" FontSize="11" Margin="8,2,8,3" TextTrimming="CharacterEllipsis"
               Foreground="{DynamicResource App.SecondaryText}" ToolTip="{Binding SourcesText}"
               Visibility="{Binding SourcesText, Converter={StaticResource Truthy}}"
               AutomationProperties.Name="Where the tables came from" />
  </Grid>
</UserControl>
