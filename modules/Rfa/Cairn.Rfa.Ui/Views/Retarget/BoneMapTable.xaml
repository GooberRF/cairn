<UserControl x:Class="Cairn.Rfa.Ui.Views.Retarget.BoneMapTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Bone map">
  <!--
    The editable bone map (DataContext: BoneMapEditorViewModel), shared by the retarget dialogs and the
    glTF animation import: target bones in hierarchy order, each with its source picker and status chip,
    Auto-map / Clear, the map's problems and the unused source bones. Theme brushes only.
  -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource DialogSmallButton}" Content="_Auto-map" Command="{Binding AutoMapCommand}" Margin="0,0,6,0"
                ToolTip="Pair every target bone automatically: exact names, canonical names, the stock rig tables, then similar body words"
                AutomationProperties.Name="Auto-map the bones" />
        <Button Style="{StaticResource DialogSmallButton}" Content="Cl_ear" Command="{Binding ClearCommand}"
                ToolTip="Set every target bone to none (each then holds a still pose); map them again by hand or with Auto-map"
                AutomationProperties.Name="Clear the bone map" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"
                 Foreground="{DynamicResource App.SecondaryText}" AutomationProperties.Name="Bone map summary" />
    </DockPanel>

    <!-- Problems and unused source bones, under the table. -->
    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" AutomationProperties.Name="Bone map problems">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,1">
              <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,2,7,0"
                         Foreground="{Binding BrushKey, Converter={StaticResource BrushKey}}" />
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.Text}" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Style="{StaticResource HintText}" Text="{Binding UnusedText}" Margin="0,4,0,0"
                 Visibility="{Binding UnusedText, Converter={StaticResource Truthy}}" AutomationProperties.Name="Unused source bones" />
    </StackPanel>

    <Border BorderThickness="1" BorderBrush="{DynamicResource App.Border}" Background="{DynamicResource App.PaneBackground}" CornerRadius="3">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{DynamicResource Table.HeaderBackground}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" MinWidth="150" />
            <ColumnDefinition Width="*" MinWidth="170" />
            <ColumnDefinition Width="112" />
            <ColumnDefinition Width="104" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="#" Margin="8,4" />
          <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="{Binding TargetHeader}" Margin="4,4" />
          <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="{Binding SourceHeader}" Margin="4,4" />
          <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="Status" Margin="4,4" />
          <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Text="Matched by" Margin="4,4" />
        </Grid>
        <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue"
                 AutomationProperties.Name="Target bones">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0,1" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="AutomationProperties.Name" Value="{Binding TargetName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="*" MinWidth="150" />
                  <ColumnDefinition Width="*" MinWidth="170" />
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding IndexText}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource App.SecondaryText}" ToolTip="The bone's index (clips address bones by it)" />
                <TextBlock Grid.Column="1" Text="{Binding TargetName}" Margin="{Binding Indent}" Padding="4,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" ToolTip="{Binding TargetName}" />
                <ComboBox Grid.Column="2" Margin="4,1" MinHeight="26" Padding="6,3" FontSize="12" VerticalContentAlignment="Center" ItemsSource="{Binding Options}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}" ToolTip="Which source bone drives this bone (none: it holds a still pose)"
                          AutomationProperties.Name="{Binding PickerName}" />
                <Border Grid.Column="3" Margin="4,2" Padding="6,1" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{Binding StatusBrushKey, Converter={StaticResource BrushKey}}" ToolTip="{Binding StatusToolTip}">
                  <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource App.Text}"
                             AutomationProperties.Name="{Binding StatusText}" />
                </Border>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                  <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0"
                             Foreground="{DynamicResource Severity.Warning}" ToolTip="{Binding Problem}"
                             Visibility="{Binding HasProblem, Converter={StaticResource Truthy}}" />
                  <TextBlock Text="{Binding MatchText}" FontSize="11" Foreground="{DynamicResource App.SecondaryText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
