<Window x:Class="Cairn.Rfa.Ui.Views.Retarget.BatchRetargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cairn.Rfa.Ui.Views.Retarget"
        Title="Batch Retarget" Width="1320" Height="840" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource App.WindowBackground}" Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="RetargetSetupTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="BatchList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Background" Value="{DynamicResource App.PaneBackground}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16,14,16,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="600" MinWidth="460" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="360" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
      <TextBlock Style="{StaticResource DialogHeading}" Text="Retarget many clips at once" />
      <TextBlock Style="{StaticResource HintText}"
                 Text="Every clip in the queue is retargeted from the source rig onto the target rig with the same bone map, with its own preset (Automatic) or the options set here, and written to the output folder under the name pattern." />
    </StackPanel>

    <TabControl x:Name="Pages" Grid.Row="1" Style="{StaticResource PanelTabControl}" AutomationProperties.Name="Batch settings">
      <TabItem Header="_Clips &amp; output" Style="{StaticResource PanelTabItem}" ToolTip="What to retarget and where the results go" AutomationProperties.Name="Clips and output">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,8,10,4" Focusable="False">
          <StackPanel>
            <StackPanel Style="{StaticResource DialogGroup}">
              <TextBlock Style="{StaticResource DialogSubheading}" Text="ADD CLIPS FROM THE LIBRARY" />
              <DockPanel Margin="0,0,0,4">
                <CheckBox DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" IsChecked="{Binding OnlyFitting, Mode=TwoWay}"
                          Content="Only clips for the source mesh" ToolTip="List only clips with the source mesh's bone count"
                          AutomationProperties.Name="Only clips for the source mesh" />
                <TextBox Text="{Binding Picker.Filter, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"
                         ToolTip="Filter (substring or wildcard, e.g. ult2_*)" AutomationProperties.Name="Filter the library clips" />
              </DockPanel>
              <ListBox Style="{StaticResource BatchList}" Height="150" ItemsSource="{Binding Picker.Items}" AutomationProperties.Name="Library clips">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel ToolTip="{Binding ToolTip}">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" FontSize="11" Margin="12,0,0,0" Foreground="{DynamicResource App.SecondaryText}" />
                      <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" MinHeight="0" Padding="6,0,0,0" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Label}">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                      </CheckBox>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Style="{StaticResource DialogSmallButton}" Content="_Add checked" Command="{Binding AddCheckedCommand}" Margin="0,0,12,0"
                        ToolTip="Add the checked clips to the queue" AutomationProperties.Name="Add the checked clips" />
                <TextBlock Style="{StaticResource RtLabel}" Text="Every clip the tables give" />
                <ComboBox Width="150" MinHeight="28" Padding="8,4" VerticalContentAlignment="Center" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass, Mode=TwoWay}" IsTextSearchEnabled="True"
                          ToolTip="An entity class from entity.tbl" AutomationProperties.Name="Entity class" />
                <Button Style="{StaticResource DialogSmallButton}" Content="Add c_lass" Command="{Binding AddClassCommand}" Margin="6,0,12,0"
                        ToolTip="Add every clip the tables give this class (states, actions and weapon blocks), once each" AutomationProperties.Name="Add the class's clips" />
                <Button Style="{StaticResource DialogSmallButton}" Content="Add _files…" Command="{Binding AddFilesCommand}"
                        ToolTip="Add .rfa files from disk" AutomationProperties.Name="Add files" />
              </StackPanel>
            </StackPanel>

            <StackPanel Style="{StaticResource DialogGroup}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource DialogSmallButton}" Content="Re_move" Command="{Binding RemoveCommand}" Margin="0,0,6,0"
                          ToolTip="Remove the selected clips from the queue" AutomationProperties.Name="Remove the selected clips" />
                  <Button Style="{StaticResource DialogSmallButton}" Content="Clear" Command="{Binding ClearCommand}"
                          ToolTip="Empty the queue" AutomationProperties.Name="Clear the queue" />
                </StackPanel>
                <TextBlock Style="{StaticResource DialogSubheading}" Text="QUEUE AND OUTPUT NAMES" />
              </DockPanel>
              <Grid Background="{DynamicResource Table.HeaderBackground}" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TableHeaderText}" Margin="6,3" Text="Clip" />
                <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Margin="4,3" Text="Bones" />
                <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Margin="4,3" Text="Output name" />
              </Grid>
              <ListBox x:Name="QueueList" Style="{StaticResource BatchList}" Height="190" ItemsSource="{Binding Clips}" SelectionMode="Extended"
                       AutomationProperties.Name="Queue" SelectionChanged="OnQueueSelectionChanged">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,1" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ToolTip="{Binding Origin}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Margin="6,0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                      <TextBlock Grid.Column="1" Margin="4,0" Text="{Binding BonesText}" Foreground="{DynamicResource App.SecondaryText}" />
                      <TextBlock Grid.Column="2" Margin="4,0" Text="{Binding OutputName}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Foreground="{DynamicResource App.Text}" />
                      <TextBlock Grid.Column="3" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Severity.Warning}" ToolTip="{Binding Problem}"
                                 Visibility="{Binding HasProblem, Converter={StaticResource Truthy}}" AutomationProperties.Name="{Binding Problem}" />
                      <!-- A quiet note, not a problem: the file is already there; the run asks before replacing. -->
                      <TextBlock Grid.Column="3" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource App.SecondaryText}" ToolTip="{Binding Note}"
                                 Visibility="{Binding HasNote, Converter={StaticResource Truthy}}" AutomationProperties.Name="{Binding Note}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" Text="{Binding NamesSummary}" />
            </StackPanel>

            <ContentControl Content="{Binding Setup}" ContentTemplate="{StaticResource PresetTemplate}" Focusable="False" IsTabStop="False" />

            <StackPanel Style="{StaticResource DialogGroup}">
              <TextBlock Style="{StaticResource DialogSubheading}" Text="OUTPUT" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource RtLabel}" Text="Folder" />
                <TextBox Grid.Column="1" Height="26" Margin="0,2" VerticalContentAlignment="Center" IsReadOnly="True" Text="{Binding OutputFolder, Mode=OneWay}"
                         ToolTip="Where the retargeted clips are written (never the game directory)" AutomationProperties.Name="Output folder" />
                <Button Grid.Column="2" Style="{StaticResource DialogSmallButton}" Margin="6,2,0,2" Content="Browse…" Command="{Binding BrowseFolderCommand}"
                        ToolTip="Choose the output folder" AutomationProperties.Name="Browse for the output folder" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource InlineDiagnosticText}" Foreground="{DynamicResource Severity.Warning}"
                           Text="{Binding OutputFolderProblem}" Visibility="{Binding OutputFolderProblem, Converter={StaticResource Truthy}}" />
                <TextBlock Grid.Row="2" Style="{StaticResource RtLabel}" Text="Name pattern" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="26" Margin="0,2" VerticalContentAlignment="Center"
                         Text="{Binding NamePattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                         ToolTip="Tokens: {rig} target profile, {clip} clip name after its prefix (park_jeep_driver → jeep_driver), {source} source name, {target} target mesh, {sourcerig} source profile"
                         AutomationProperties.Name="Output name pattern" />
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource HintText}"
                           Text="{}{rig} target profile · {clip} clip after its prefix · {source} source name · {target} target mesh · {sourcerig} source profile" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="R_igs" Style="{StaticResource PanelTabItem}" ToolTip="The source and target rigs and the profile" AutomationProperties.Name="Rigs">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,8,10,4" Focusable="False">
          <ContentControl Content="{Binding Setup}" ContentTemplate="{StaticResource RigsTemplate}" Focusable="False" IsTabStop="False" />
        </ScrollViewer>
      </TabItem>

      <TabItem Header="_Bone map" Style="{StaticResource PanelTabItem}" ToolTip="Which source bone drives each target bone" AutomationProperties.Name="Bone map">
        <local:BoneMapTable DataContext="{Binding Setup.Map}" Margin="2,8,4,4" />
      </TabItem>

      <TabItem Header="_Options" Style="{StaticResource PanelTabItem}" ToolTip="Rest alignment, IK, root motion, bone lengths, keys" AutomationProperties.Name="Options">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="2,8,10,4" Focusable="False">
          <ContentControl Content="{Binding Setup}" ContentTemplate="{StaticResource OptionsTemplate}" Focusable="False" IsTabStop="False" />
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                  ResizeBehavior="PreviousAndNext" Focusable="False" ToolTip="Drag to resize" AutomationProperties.Name="Resize the panels" />

    <!-- Progress and results -->
    <DockPanel Grid.Row="1" Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource DialogSubheading}" Text="RESULTS" />
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,2,0,4" AutomationProperties.Name="Progress" />
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="12" Margin="12,0,0,0" AutomationProperties.Name="Results summary" />
          <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource App.SecondaryText}" TextTrimming="CharacterEllipsis"
                     AutomationProperties.Name="Progress text" />
        </DockPanel>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <Button Style="{StaticResource DialogSmallButton}" Content="Copy _table lines" Command="{Binding CopyTableLinesCommand}" Margin="0,0,6,0"
                ToolTipService.ShowOnDisabled="True"
                ToolTip="Copy entity.tbl lines that give the new clips the same states and actions as their sources" AutomationProperties.Name="Copy table lines" />
        <Button Style="{StaticResource DialogSmallButton}" Content="Save re_port…" Command="{Binding SaveReportCommand}"
                ToolTipService.ShowOnDisabled="True" ToolTip="Save the results (and the table lines) as Markdown or text" AutomationProperties.Name="Save report" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource HintText}" Margin="0,4,0,0" Text="Double-click a result to open the new clip (previewed on the target mesh)." />
      <Border BorderThickness="1" BorderBrush="{DynamicResource App.Border}" Background="{DynamicResource App.PaneBackground}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Background="{DynamicResource Table.HeaderBackground}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="86" />
              <ColumnDefinition Width="84" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource TableHeaderText}" Margin="6,3" Text="Clip" />
            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Margin="4,3" Text="Status" />
            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Margin="4,3" Text="Preset" ToolTip="The preset the clip was retargeted with (chosen per clip with Automatic)" />
            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Margin="4,3" Text="Output" />
            <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderText}" Margin="4,3" Text="Pinned contacts" ToolTip="What IK held (feet, hands) and its worst distance: about 0 unless a limb could not reach (fully stretched)" />
            <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderText}" Margin="4,3" Text="⚠" ToolTip="Warnings" />
          </Grid>
          <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" BorderThickness="0" Background="Transparent"
                   VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   MouseDoubleClick="OnResultDoubleClick" KeyDown="OnResultKeyDown" AutomationProperties.Name="Results">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0,1" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Clip}" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ToolTip="{Binding ToolTip}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="34" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Margin="6,0" Text="{Binding Clip}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                  <Border Grid.Column="1" Margin="4,1" Padding="6,0" CornerRadius="8" HorizontalAlignment="Left"
                          Background="{Binding StatusBrushKey, Converter={StaticResource BrushKey}}">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource App.Text}" />
                  </Border>
                  <TextBlock Grid.Column="2" Margin="4,0" Text="{Binding PresetText}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.Text}" />
                  <TextBlock Grid.Column="3" Margin="4,0" Text="{Binding Output}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             Foreground="{DynamicResource App.Text}" />
                  <TextBlock Grid.Column="4" Margin="4,0" Text="{Binding PinnedText}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource App.SecondaryText}" />
                  <TextBlock Grid.Column="5" Margin="4,0" Text="{Binding WarningsText}" FontSize="12" Foreground="{DynamicResource Severity.Warning}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </DockPanel>

    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource DialogButton}" Content="_Run" IsDefault="True" Command="{Binding RunCommand}"
                ToolTipService.ShowOnDisabled="True" ToolTip="Retarget every queued clip and write the results" AutomationProperties.Name="Run the batch" />
        <Button Style="{StaticResource DialogButton}" Content="_Stop" Command="{Binding StopCommand}"
                ToolTipService.ShowOnDisabled="True" ToolTip="Stop after the clip being retargeted (what is done stays written)" AutomationProperties.Name="Stop the batch" />
        <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True" Click="OnClose" ToolTip="Close the dialog (Esc); a running batch is stopped first"
                AutomationProperties.Name="Close" />
      </StackPanel>
      <TextBlock Text="{Binding RunBlocker}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource App.SecondaryText}"
                 AutomationProperties.Name="Why the batch cannot run" />
    </DockPanel>
  </Grid>
</Window>
