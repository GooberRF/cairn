<UserControl x:Class="Cairn.Rfa.Ui.Views.MeshStructureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cui="clr-namespace:Cairn.Ui.Controls;assembly=Cairn.Ui"
             xmlns:vm="clr-namespace:Cairn.Rfa.Ui.ViewModels"
             xmlns:me="clr-namespace:Cairn.Rfa.Ui.ViewModels.MeshEditing"
             xmlns:controls="clr-namespace:Cairn.Rfa.Ui.Controls">
  <UserControl.Resources>
    <Style x:Key="EditorLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    </Style>

    <Style x:Key="EditorSection" TargetType="TextBlock" BasedOn="{StaticResource DialogSubheading}">
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- A read-only document's number boxes look disabled like the rest of its editor. -->
    <Style TargetType="cui:NumericBox">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <ItemsPanelTemplate x:Key="ThreeWide">
      <UniformGrid Columns="3" />
    </ItemsPanelTemplate>

    <!-- A text field: label | box. -->
    <DataTemplate x:Key="TextRow" DataType="{x:Type me:MeshTextField}">
      <Grid ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource EditorLabel}" Text="{Binding Label}" />
        <TextBox Grid.Column="1" Margin="0,2" FontSize="12" VerticalContentAlignment="Center" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 MaxLength="{Binding MaxLength}" IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding ToolTip}"
                 AutomationProperties.Name="{Binding Label}" />
      </Grid>
    </DataTemplate>

    <!-- A pick from a list: label | combo box. -->
    <DataTemplate x:Key="ChoiceRow" DataType="{x:Type me:MeshChoiceField}">
      <Grid ToolTip="{Binding ToolTip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource EditorLabel}" Text="{Binding Label}" />
        <ComboBox Grid.Column="1" Margin="0,2" FontSize="12" ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Label" IsEnabled="{Binding IsEditable}"
                  VirtualizingPanel.IsVirtualizing="True" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="{Binding Label}">
          <ComboBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ComboBox.ItemsPanel>
        </ComboBox>
      </Grid>
    </DataTemplate>

    <!-- A number: label | box. -->
    <DataTemplate x:Key="NumberRow" DataType="{x:Type me:MeshNumberField}">
      <Grid ToolTip="{Binding ToolTip}" Margin="0,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource EditorLabel}" Text="{Binding Label}" />
        <cui:NumericBox Grid.Column="1" MinWidth="0" Value="{Binding Value, Mode=TwoWay}" Decimals="{Binding Decimals}"
                             Step="{Binding Step}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Suffix="{Binding Suffix}"
                             IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}"
                             InteractionStarted="OnInteractionStarted" InteractionEnded="OnInteractionEnded" />
      </Grid>
    </DataTemplate>

    <!-- A number in a 3-wide row: caption above the box. -->
    <DataTemplate x:Key="CompactNumber" DataType="{x:Type me:MeshNumberField}">
      <StackPanel Margin="0,0,4,0">
        <TextBlock Text="{Binding Caption}" FontSize="10.5" Foreground="{DynamicResource App.SecondaryText}" Margin="1,0,0,2"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTip}" />
        <cui:NumericBox MinWidth="0" Value="{Binding Value, Mode=TwoWay}" Decimals="{Binding Decimals}" Step="{Binding Step}"
                             Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Suffix="{Binding Suffix}"
                             IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}"
                             InteractionStarted="OnInteractionStarted" InteractionEnded="OnInteractionEnded" />
      </StackPanel>
    </DataTemplate>

    <!-- ── Editors, by node kind ─────────────────────────────────────────── -->

    <DataTemplate DataType="{x:Type me:BoneEditor}">
      <StackPanel>
        <ContentControl Content="{Binding Name}" ContentTemplate="{StaticResource TextRow}" Focusable="False" IsTabStop="False" Tag="RenameTarget" />
        <ContentControl Content="{Binding Parent}" ContentTemplate="{StaticResource ChoiceRow}" Focusable="False" IsTabStop="False" />

        <TextBlock Text="BIND POSE" Style="{StaticResource EditorSection}"
                   ToolTip="The pose the skin is bound to (the file stores its inverse). Changing it moves the skinned mesh and every clip's rest reference." />
        <DockPanel Margin="0,0,0,4">
          <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4" Padding="1"
                  IsEnabled="{Binding IsEditable}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource SegmentButton}" MinWidth="58" Height="24" Content="Local" IsChecked="{Binding IsLocalSpace, Mode=TwoWay}"
                           ToolTip="Show and edit the bind pose relative to the parent bone's rest frame" AutomationProperties.Name="Local (parent) space" />
              <RadioButton Style="{StaticResource SegmentButton}" MinWidth="58" Height="24" Content="World" IsChecked="{Binding IsWorldSpace, Mode=TwoWay}"
                           ToolTip="Show and edit the bind pose in model space" AutomationProperties.Name="World (model) space" />
            </StackPanel>
          </Border>
          <CheckBox Content="Children follow" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource App.Text}"
                    IsChecked="{Binding ChildrenFollow, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Move the bone's descendants with it (their positions relative to it stay). Off: they stay where they are in the model."
                    AutomationProperties.Name="Children follow the bone" />
        </DockPanel>
        <TextBlock Text="{Binding SpaceNote}" Style="{StaticResource HintText}" Margin="0,0,0,6" />
        <TextBlock Text="Position (metres)" Style="{StaticResource EditorLabel}" Margin="0,0,0,2" />
        <ItemsControl ItemsSource="{Binding Position}" ItemTemplate="{StaticResource CompactNumber}" ItemsPanel="{StaticResource ThreeWide}"
                      Focusable="False" Margin="0,0,0,6" AutomationProperties.Name="Bind position" />
        <TextBlock Text="Rotation (degrees)" Style="{StaticResource EditorLabel}" Margin="0,0,0,2"
                   ToolTip="Pitch, yaw and roll: q = Ry(yaw) · Rx(pitch) · Rz(roll), as in the Key inspector" />
        <ItemsControl ItemsSource="{Binding Rotation}" ItemTemplate="{StaticResource CompactNumber}" ItemsPanel="{StaticResource ThreeWide}"
                      Focusable="False" Margin="0,0,0,2" AutomationProperties.Name="Bind rotation" />

        <TextBlock Text="INDEX ORDER" Style="{StaticResource EditorSection}"
                   ToolTip="Clips address bones by index: changing the order asks first and offers to conform the open clips that preview this mesh." />
        <WrapPanel>
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Move up" Command="{Binding MoveUpCommand}"
                  ToolTip="Give this bone the index before it (Alt+Up in the tree); asks first, because clips address bones by index"
                  ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Move the bone up in the index order" />
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Move down" Command="{Binding MoveDownCommand}"
                  ToolTip="Give this bone the index after it (Alt+Down in the tree); asks first, because clips address bones by index"
                  ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Move the bone down in the index order" />
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Reorder…" Command="{Binding ReorderCommand}"
                  ToolTip="Arrange every bone's index in one go (Mesh › Reorder Bones…)" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Reorder bones" />
        </WrapPanel>
        <TextBlock Text="{Binding IndexText, StringFormat=Index {0}}" Style="{StaticResource HintText}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type me:SphereEditor}">
      <StackPanel>
        <ContentControl Content="{Binding Name}" ContentTemplate="{StaticResource TextRow}" Focusable="False" IsTabStop="False" Tag="RenameTarget" />
        <ContentControl Content="{Binding Bone}" ContentTemplate="{StaticResource ChoiceRow}" Focusable="False" IsTabStop="False" />
        <TextBlock Text="CENTRE (METRES, IN THE BONE'S FRAME)" Style="{StaticResource EditorSection}" ToolTip="{Binding Position[0].ToolTip}" />
        <ItemsControl ItemsSource="{Binding Position}" ItemTemplate="{StaticResource CompactNumber}" ItemsPanel="{StaticResource ThreeWide}"
                      Focusable="False" Margin="0,0,0,6" AutomationProperties.Name="Sphere centre" />
        <ContentControl Content="{Binding Radius}" ContentTemplate="{StaticResource NumberRow}" Focusable="False" IsTabStop="False" />
        <WrapPanel Margin="0,10,0,0">
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Add" Command="{Binding Tools.AddSphereCommand}"
                  ToolTip="Add a collision sphere on this sphere's bone (Mesh › Add Collision Sphere)" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Add a collision sphere" />
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Duplicate" Command="{Binding Tools.DuplicateSphereCommand}"
                  ToolTip="Add a copy of this sphere (Mesh › Duplicate Collision Sphere)" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Duplicate the collision sphere" />
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Remove" Command="{Binding Tools.RemoveSelectedCommand}"
                  ToolTip="Remove this sphere (Del in the tree; Mesh › Remove Selected)" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Remove the collision sphere" />
        </WrapPanel>
        <TextBlock Text="{Binding IndexText, StringFormat=Sphere {0}}" Style="{StaticResource HintText}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type me:PropPointEditor}">
      <StackPanel>
        <ContentControl Content="{Binding Name}" ContentTemplate="{StaticResource TextRow}" Focusable="False" IsTabStop="False" Tag="RenameTarget" />
        <ContentControl Content="{Binding Bone}" ContentTemplate="{StaticResource ChoiceRow}" Focusable="False" IsTabStop="False" />
        <TextBlock Text="POSITION (METRES)" Style="{StaticResource EditorSection}" ToolTip="{Binding Position[0].ToolTip}" />
        <ItemsControl ItemsSource="{Binding Position}" ItemTemplate="{StaticResource CompactNumber}" ItemsPanel="{StaticResource ThreeWide}"
                      Focusable="False" Margin="0,0,0,6" AutomationProperties.Name="Prop point position" />
        <TextBlock Text="ORIENTATION (DEGREES)" Style="{StaticResource EditorSection}" Margin="0,6,0,4" ToolTip="{Binding Orientation[0].ToolTip}" />
        <ItemsControl ItemsSource="{Binding Orientation}" ItemTemplate="{StaticResource CompactNumber}" ItemsPanel="{StaticResource ThreeWide}"
                      Focusable="False" Margin="0,0,0,6" AutomationProperties.Name="Prop point orientation" />
        <WrapPanel Margin="0,6,0,0">
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Add" Command="{Binding Tools.AddPropPointCommand}"
                  ToolTip="Add a prop point on this one's bone, in every LOD (Mesh › Add Prop Point)" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Add a prop point" />
          <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,6,4" Content="Remove" Command="{Binding Tools.RemoveSelectedCommand}"
                  ToolTip="Remove this prop point from every LOD (Del in the tree; Mesh › Remove Selected)" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="Remove the prop point" />
        </WrapPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type me:MaterialEditor}">
      <StackPanel>
        <ContentControl Content="{Binding Texture}" ContentTemplate="{StaticResource TextRow}" Focusable="False" IsTabStop="False" Tag="RenameTarget" />
        <DockPanel Margin="92,2,0,6">
          <Button DockPanel.Dock="Left" Style="{StaticResource DialogSmallButton}" Margin="0,0,10,0" Content="Browse…" VerticalAlignment="Top"
                  Command="{Binding BrowseCommand}" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Pick from every texture in the mesh's folder, the search folders and the game's archives"
                  AutomationProperties.Name="Browse for a texture" />
          <CheckBox VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource App.Text}"
                    IsChecked="{Binding RenameAllLodEntries, Mode=TwoWay}" IsEnabled="{Binding IsEditable}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Off: only the LOD texture entries named like the old texture follow. On: every LOD entry of this material (foo-mip1.tga included) gets the new name."
                    AutomationProperties.Name="Rename every LOD entry of this material">
            <TextBlock Text="All LOD entries" TextWrapping="Wrap" />
          </CheckBox>
        </DockPanel>
        <ContentControl Content="{Binding Emissive}" ContentTemplate="{StaticResource NumberRow}" Focusable="False" IsTabStop="False" />
        <TextBlock Text="STORED, NOT USED BY THE ENGINE" Style="{StaticResource EditorSection}"
                   ToolTip="These fields are kept byte for byte; the game ignores them (see the format reference)." />
        <ContentControl Content="{Binding ReflectionCoefficient}" ContentTemplate="{StaticResource NumberRow}" Focusable="False" IsTabStop="False" />
        <ContentControl Content="{Binding ReflectionMap}" ContentTemplate="{StaticResource TextRow}" Focusable="False" IsTabStop="False" />
        <ContentControl Content="{Binding Flags}" ContentTemplate="{StaticResource TextRow}" Focusable="False" IsTabStop="False" />
        <ContentControl Content="{Binding Unknown0}" ContentTemplate="{StaticResource NumberRow}" Focusable="False" IsTabStop="False" />
        <ContentControl Content="{Binding Unknown1}" ContentTemplate="{StaticResource NumberRow}" Focusable="False" IsTabStop="False" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type me:LodEditor}">
      <StackPanel>
        <ContentControl Content="{Binding Distance}" ContentTemplate="{StaticResource NumberRow}" Focusable="False" IsTabStop="False" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type me:SubmeshEditor}">
      <StackPanel>
        <ContentControl Content="{Binding Name}" ContentTemplate="{StaticResource TextRow}" Focusable="False" IsTabStop="False" Tag="RenameTarget" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="2*" MinHeight="80" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="120" />
    </Grid.RowDefinitions>

    <TreeView x:Name="Tree" Grid.Row="0" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
              SelectedItemChanged="OnSelectedItemChanged" PreviewKeyDown="OnTreeKeyDown" Padding="2,4"
              AutomationProperties.Name="Mesh structure"
              ToolTip="Select a node to edit it below. Del removes a sphere or prop point; Alt+Up / Alt+Down move a bone; F2 renames.">
      <TreeView.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource PaneScrollBar}" />
      </TreeView.Resources>
      <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource PaneTreeViewItem}">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          <Setter Property="ToolTip" Value="{Binding ToolTip}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Header}" />
          <Setter Property="Padding" Value="1,1" />
        </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:MeshNodeViewModel}" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="18"
                       VerticalAlignment="Center" Foreground="{DynamicResource App.SecondaryText}" />
            <TextBlock Text="{Binding Header}" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}" ResizeDirection="Rows"
                  ResizeBehavior="PreviousAndNext" ToolTip="Drag to resize the editor pane"
                  AutomationProperties.Name="Resize the editor pane" />

    <Border Grid.Row="2" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeaderBorder}">
          <TextBlock Text="{Binding SelectedHeader}" Style="{StaticResource PaneHeaderText}" TextTrimming="CharacterEllipsis" />
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,6" Focusable="False"
                      PreviewKeyDown="OnEditorKeyDown">
          <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource PaneScrollBar}" />
          </ScrollViewer.Resources>
          <StackPanel>
            <DockPanel Margin="0,0,0,6" Visibility="{Binding IsReadOnly, Converter={StaticResource Truthy}}"
                       AutomationProperties.Name="Read-only">
              <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,1,6,0"
                         Foreground="{DynamicResource Severity.Info}" />
              <TextBlock Text="Static meshes open read-only." Style="{StaticResource HintText}" />
            </DockPanel>

            <ContentControl x:Name="EditorHost" Content="{Binding Editor}" Focusable="False" IsTabStop="False"
                            IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}" AutomationProperties.Name="Editor" />

            <DockPanel Margin="0,6,0,0" Visibility="{Binding Editor.HasError, Converter={StaticResource Truthy}, FallbackValue=Collapsed}">
              <TextBlock DockPanel.Dock="Left" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,2,7,0"
                         Foreground="{DynamicResource Severity.Error}" />
              <TextBlock Text="{Binding Editor.Error}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Severity.Error}"
                         AutomationProperties.Name="Why the edit was refused" />
            </DockPanel>

            <TextBlock Text="FACTS" Style="{StaticResource EditorSection}"
                       Visibility="{Binding ShowFactsHeading, Converter={StaticResource Truthy}}" />
            <ItemsControl ItemsSource="{Binding SelectedFacts}" Focusable="False" AutomationProperties.Name="Facts">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding ToolTip}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FactLabel}" Text="{Binding Label}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Value, Mode=OneWay}"
                             AutomationProperties.Name="{Binding Label}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
