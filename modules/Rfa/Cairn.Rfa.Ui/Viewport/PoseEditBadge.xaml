<UserControl x:Class="Cairn.Rfa.Ui.Viewport.PoseEditBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
             IsHitTestVisible="False" Focusable="False"
             Visibility="{Binding BadgeVisible, Converter={StaticResource Truthy}, FallbackValue=Collapsed}"
             AutomationProperties.Name="Gizmo mode">
  <!-- DataContext: the document's gizmo target (PoseEditController or MeshEditController). Says what a drag does,
       or why there is no gizmo. -->
  <Border Padding="8,4" CornerRadius="4" BorderThickness="1" MaxWidth="520"
          Background="{DynamicResource PoseBadge.Background}" BorderBrush="{DynamicResource App.Border}">
    <StackPanel>
      <DockPanel Visibility="{Binding ModeText, Converter={StaticResource Truthy}}">
        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,7,0" VerticalAlignment="Top">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="{DynamicResource PoseBadge.AutoKey}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Layer">
                  <Setter Property="Fill" Value="{DynamicResource PoseBadge.Layer}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Ik">
                  <Setter Property="Fill" Value="{DynamicResource PoseBadge.Ik}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="Mesh">
                  <Setter Property="Fill" Value="{DynamicResource PoseBadge.Mesh}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Text="{Binding ModeText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource PoseBadge.Text}" />
      </DockPanel>
      <TextBlock Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PoseBadge.HintText}"
                 Visibility="{Binding Hint, Converter={StaticResource Truthy}}" />
    </StackPanel>
  </Border>
</UserControl>
