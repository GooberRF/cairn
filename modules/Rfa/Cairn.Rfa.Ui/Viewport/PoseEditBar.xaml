<UserControl x:Class="Cairn.Rfa.Ui.Viewport.PoseEditBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cui="clr-namespace:Cairn.Ui.Controls;assembly=Cairn.Ui"
             xmlns:controls="clr-namespace:Cairn.Rfa.Ui.Controls"
             AutomationProperties.Name="Gizmo tools">
  <!-- DataContext: the document's gizmo target (set by ViewportControl): a clip tab's PoseEditController or a
       mesh tab's MeshEditController. The clip-only and mesh-only groups get their own DataContext in code. -->
  <UserControl.Resources>
    <Style x:Key="BarIcon" TargetType="Path">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    </Style>
    <Style x:Key="BarSep" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="3,4" />
      <Setter Property="Fill" Value="{DynamicResource App.Border}" />
    </Style>
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal">
    <RadioButton Style="{StaticResource ToolToggle}" GroupName="PoseTool" IsChecked="{Binding IsSelectTool, Mode=TwoWay}"
                 ToolTip="{Binding SelectToolTip}"
                 AutomationProperties.Name="Select tool">
      <Path Style="{StaticResource BarIcon}" Data="M4,2.5 L4,13 L6.8,10.4 L8.8,14.2 L10.6,13.3 L8.6,9.6 L12.2,9.4 Z" />
    </RadioButton>
    <RadioButton Style="{StaticResource ToolToggle}" GroupName="PoseTool" IsChecked="{Binding IsRotateTool, Mode=TwoWay}"
                 ToolTip="{Binding RotateToolTip}"
                 AutomationProperties.Name="Rotate tool">
      <Path Style="{StaticResource BarIcon}" Data="M13,8 A5,5 0 1 1 10.5,3.7 M10.5,1.5 L10.8,3.9 L8.4,4.4" />
    </RadioButton>
    <RadioButton Style="{StaticResource ToolToggle}" GroupName="PoseTool" IsChecked="{Binding IsMoveTool, Mode=TwoWay}"
                 ToolTip="{Binding MoveToolTip}"
                 AutomationProperties.Name="Move tool">
      <Path Style="{StaticResource BarIcon}" Data="M8,1.5 V14.5 M1.5,8 H14.5 M6,3.5 L8,1.5 L10,3.5 M6,12.5 L8,14.5 L10,12.5 M3.5,6 L1.5,8 L3.5,10 M12.5,6 L14.5,8 L12.5,10" />
    </RadioButton>
    <ComboBox Height="24" MinWidth="70" Padding="6,2" Margin="3,0,0,0" VerticalContentAlignment="Center" FontSize="11"
              ItemsSource="{Binding SpaceChoices}" SelectedValuePath="Value" SelectedValue="{Binding Space, Mode=TwoWay}"
              DisplayMemberPath="Label"
              ToolTip="{Binding SpaceToolTip}"
              AutomationProperties.Name="Gizmo space" />

    <!-- Mesh tabs: the bone editor's "children follow", where it is seen while dragging a bind. -->
    <StackPanel x:Name="MeshGroup" Orientation="Horizontal" Visibility="Collapsed">
      <Rectangle Style="{StaticResource BarSep}" />
      <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ChildrenFollow, Mode=TwoWay}"
                    ToolTip="Children follow (bone binds): when you move or turn a bone's bind pose, the bones below it move and turn with it. Off: they stay where they are in the model. The bone editor's Children follow box is the same setting."
                    AutomationProperties.Name="Children follow">
        <StackPanel Orientation="Horizontal">
          <Path Style="{StaticResource BarIcon}" Data="M3,3.5 L8,8 L13,12.5 M1.9,3.5 A1.1,1.1 0 1 1 4.1,3.5 A1.1,1.1 0 1 1 1.9,3.5 M6.9,8 A1.1,1.1 0 1 1 9.1,8 A1.1,1.1 0 1 1 6.9,8 M11.9,12.5 A1.1,1.1 0 1 1 14.1,12.5 A1.1,1.1 0 1 1 11.9,12.5" />
          <TextBlock Text="Children" FontSize="11" Margin="3,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>
    </StackPanel>

    <!-- Clip tabs: auto-key with its layer-range options, and IK. -->
    <StackPanel x:Name="ClipGroup" Orientation="Horizontal">
      <Rectangle Style="{StaticResource BarSep}" />
      <ToggleButton x:Name="AutoKeyToggle" Style="{StaticResource ToolToggle}" IsChecked="{Binding AutoKey, Mode=TwoWay}"
                    ToolTip="Auto-key (on): a drag writes a key for the selected bone(s) at the playhead, replacing a key there; the motion elsewhere is unchanged.&#x0a;Off: layer edit, the same offset is added to every key of the bone (limit it to a time range in the options next to this button)."
                    AutomationProperties.Name="Auto-key">
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="9" Height="9" VerticalAlignment="Center" Stroke="{DynamicResource PoseBadge.AutoKey}" StrokeThickness="1.4">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="Transparent" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding AutoKey}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource PoseBadge.AutoKey}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="Key" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>
      <Button x:Name="OptionsButton" Style="{StaticResource ToolButton}" Height="24" MinWidth="16" Padding="2,0" Click="OnOptionsClick"
              ToolTip="Layer edit options: limit the offset to a time range with falloff"
              AutomationProperties.Name="Layer edit options">
        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" VerticalAlignment="Center" />
      </Button>
      <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding IkEnabled, Mode=TwoWay}"
                    ToolTip="IK: with the move tool on a hand or foot, drag it and the arm or leg follows (two-bone IK; the shoulder or hip stays put, the hand keeps its orientation). Keys the three bones at the playhead. Needs a rig whose limb chains are known."
                    AutomationProperties.Name="IK drag">
        <TextBlock Text="IK" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
      </ToggleButton>

      <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True">
        <Border Padding="10" CornerRadius="4" BorderThickness="1" Margin="0,2,6,6"
                Background="{DynamicResource App.PaneBackground}" BorderBrush="{DynamicResource App.Border}"
                TextElement.Foreground="{DynamicResource App.Text}">
          <StackPanel Width="250">
            <TextBlock Text="Layer edit (auto-key off)" FontWeight="SemiBold" Margin="0,0,0,6" />
            <CheckBox Content="Only in a time range" IsChecked="{Binding RangeEnabled, Mode=TwoWay}"
                      ToolTip="Limit the offset to the range below; outside it the motion is untouched"
                      AutomationProperties.Name="Limit to a time range" />
            <Grid Margin="0,8,0,0" IsEnabled="{Binding RangeEnabled}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="From" VerticalAlignment="Center" />
              <cui:NumericBox Grid.Column="1" Value="{Binding RangeFrom, Mode=TwoWay}" Decimals="{Binding UnitDecimals}"
                                   Suffix="{Binding UnitSuffix}" Minimum="-100000" Maximum="100000"
                                   AutomationProperties.Name="Range from" ToolTip="Start of the full-strength range" />
              <Button Grid.Column="2" Style="{StaticResource ToolButton}" Margin="4,0,0,0" Click="OnFromPlayheadClick"
                      ToolTip="Start the range at the playhead" AutomationProperties.Name="Range from the playhead">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
              </Button>
              <TextBlock Grid.Row="1" Text="To" VerticalAlignment="Center" Margin="0,6,0,0" />
              <cui:NumericBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Value="{Binding RangeTo, Mode=TwoWay}"
                                   Decimals="{Binding UnitDecimals}" Suffix="{Binding UnitSuffix}" Minimum="-100000" Maximum="100000"
                                   AutomationProperties.Name="Range to" ToolTip="End of the full-strength range" />
              <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource ToolButton}" Margin="4,6,0,0" Click="OnToPlayheadClick"
                      ToolTip="End the range at the playhead" AutomationProperties.Name="Range to the playhead">
                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
              </Button>
              <TextBlock Grid.Row="2" Text="Falloff" VerticalAlignment="Center" Margin="0,6,0,0" />
              <cui:NumericBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Value="{Binding Falloff, Mode=TwoWay}"
                                   Decimals="{Binding UnitDecimals}" Suffix="{Binding UnitSuffix}" Minimum="0" Maximum="100000"
                                   AutomationProperties.Name="Falloff"
                                   ToolTip="How long the offset takes to fade in before the range and out after it (smoothstep)" />
            </Grid>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource App.SecondaryText}"
                       Text="Keys are added at the range ends so the motion outside stays exactly as it was." />
          </StackPanel>
        </Border>
      </Popup>
    </StackPanel>
  </StackPanel>
</UserControl>
