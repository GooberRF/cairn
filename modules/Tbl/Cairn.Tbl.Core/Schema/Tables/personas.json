          "type": "ref",
          "required": true,
          "ref": "foley",
          "doc": "Line spoken when becoming alert."
        },
        {
          "name": "$Under Alert:",
          "type": "ref",
          "required": true,
          "ref": "foley",
          "doc": "Line spoken while alert."
        },
        {
          "name": "$Cower:",
          "type": "ref",
          "required": true,
          "ref": "foley",
          "doc": "Line spoken while cowering."
        },
        {
          "name": "$Flee:",
          "type": "ref",
          "required": true,
          "ref": "foley",
          "doc": "Line spoken while fleeing."
        },
        {
          "name": "$Use Key:",
          "type": "ref",
          "required": true,
          "ref": "foley",
          "doc": "Line spoken when the player uses the character."
        },
        {
