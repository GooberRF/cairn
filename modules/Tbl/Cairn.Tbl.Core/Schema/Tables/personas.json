        {
          "name": "$Fight Single:",
          "type": "ref",
          "required": true,
          "ref": "foley",
          "doc": "Line spoken when fighting one enemy."
        },
        {
          "name": "$Fight Mult:",
          "type": "ref",
          "required": true,
          "ref": "foley",
          "doc": "Line spoken when fighting several enemies."
