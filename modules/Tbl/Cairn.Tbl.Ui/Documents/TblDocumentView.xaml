<UserControl x:Class="Cairn.Tbl.Ui.Documents.TblDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:local="clr-namespace:Cairn.Tbl.Ui.Documents"
             Background="{DynamicResource Editor.Background}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The file changed on disk -->
    <Border x:Name="ExternalChangeBar" Grid.Row="0" Visibility="Collapsed" Padding="10,6"
            Background="{DynamicResource Severity.WarningSoft}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ReloadButton" Content="Reload" Margin="6,0,0,0" Padding="10,2" Command="{Binding ReloadCommand}"
                  ToolTip="Replace the text with the file on disk (undoable)" AutomationProperties.Name="Reload from disk" />
          <Button x:Name="KeepButton" Content="Keep mine" Margin="6,0,0,0" Padding="10,2" Command="{Binding KeepMineCommand}"
                  ToolTip="Keep the text in the editor; saving overwrites the file" AutomationProperties.Name="Keep my version" />
        </StackPanel>
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" TextWrapping="Wrap"
                   Text="The file was changed outside Cairn." />
      </DockPanel>
    </Border>
    <Border x:Name="MissingBar" Grid.Row="1" Visibility="Collapsed" Padding="10,6"
            Background="{DynamicResource Severity.ErrorSoft}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Command="{Binding DismissMissingCommand}"
                ToolTip="Hide this message; Save writes the file again" AutomationProperties.Name="Dismiss" />
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" TextWrapping="Wrap"
                   Text="The file was deleted or renamed on disk. Save writes it again." />
      </DockPanel>
    </Border>

    <!-- Find / replace -->
    <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed" Padding="8,5" Background="{DynamicResource App.PaneBackground}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBox x:Name="FindBox" Width="240" Margin="0,0,6,0" VerticalContentAlignment="Center"
                   ToolTip="Text to find (Enter: next, Shift+Enter: previous, Esc: close)" AutomationProperties.Name="Find" />
          <Button x:Name="FindPrevButton" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Padding="8,3" Margin="0,0,2,0"
                  ToolTip="Previous match (Shift+F3)" AutomationProperties.Name="Previous match" />
          <Button x:Name="FindNextButton" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Padding="8,3" Margin="0,0,8,0"
                  ToolTip="Next match (F3)" AutomationProperties.Name="Next match" />
          <CheckBox x:Name="MatchCaseBox" Content="Match case" VerticalAlignment="Center" Margin="0,0,10,0"
                    ToolTip="Only find text with the same upper and lower case" AutomationProperties.Name="Match case" />
          <TextBlock x:Name="MatchStatus" VerticalAlignment="Center" Foreground="{DynamicResource App.Text}" Opacity="0.75" Margin="0,0,10,0" />
          <Button x:Name="CloseFindButton" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Padding="8,3"
                  ToolTip="Close (Esc)" AutomationProperties.Name="Close find" />
        </StackPanel>
        <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
          <TextBox x:Name="ReplaceBox" Width="240" Margin="0,0,6,0" VerticalContentAlignment="Center"
                   ToolTip="Replacement text (Enter: replace and find the next)" AutomationProperties.Name="Replace with" />
          <Button x:Name="ReplaceButton" Content="Replace" Padding="10,3" Margin="0,0,4,0"
                  ToolTip="Replace this match and find the next" AutomationProperties.Name="Replace" />
          <Button x:Name="ReplaceAllButton" Content="Replace all" Padding="10,3"
                  ToolTip="Replace every match (one undo step)" AutomationProperties.Name="Replace all" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid x:Name="Body" Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition x:Name="SplitterColumn" Width="0" />
        <ColumnDefinition x:Name="RightColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <ae:TextEditor x:Name="Editor" Grid.Column="0" FontFamily="Cascadia Mono, Consolas" FontSize="13" ShowLineNumbers="True"
                     Background="{DynamicResource Editor.Background}" Foreground="{DynamicResource Editor.Foreground}"
                     LineNumbersForeground="{DynamicResource Editor.LineNumber}" Padding="2,0,0,0"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Table text" />
      <Button x:Name="QuickFixButton" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,22,0"
              Visibility="Collapsed" Padding="6,2" FontFamily="Segoe MDL2 Assets" Content="&#xEA80;"
              ToolTip="Quick fixes (Ctrl+.)" AutomationProperties.Name="Quick fixes" />
      <GridSplitter x:Name="RightSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Visibility="Collapsed"
                    Background="{DynamicResource App.SubtleBorder}" ResizeBehavior="PreviousAndNext"
                    ToolTip="Drag to resize the preview" AutomationProperties.Name="Preview splitter" />
      <local:TblPaneHost x:Name="RightHost" Grid.Column="2" Background="{DynamicResource App.PaneBackground}" />
    </Grid>
  </Grid>
</UserControl>
