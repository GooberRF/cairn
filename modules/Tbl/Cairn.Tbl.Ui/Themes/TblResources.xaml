<!-- The table module's resources: syntax colours for both themes, the completion popup styles and the hidden
     stock search panel (the document view has its own find/replace bar). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">

  <!-- Dark theme (editor background #1B1B1E) -->
  <Color x:Key="Tbl.Dark.Text">#FFE4E4E8</Color>
  <Color x:Key="Tbl.Dark.Comment">#FF6FA96F</Color>
  <Color x:Key="Tbl.Dark.SectionHeader">#FFC792EA</Color>
  <Color x:Key="Tbl.Dark.FieldName">#FF7FB7F5</Color>
  <Color x:Key="Tbl.Dark.String">#FFD98B70</Color>
  <Color x:Key="Tbl.Dark.Number">#FF7FD0BE</Color>
  <Color x:Key="Tbl.Dark.Keyword">#FF9C8CF5</Color>
  <Color x:Key="Tbl.Dark.Brace">#FF9A9AA4</Color>
  <Color x:Key="Tbl.Dark.FileName">#FFE6C07B</Color>
  <Color x:Key="Tbl.Dark.RefName">#FF56C8E8</Color>
  <Color x:Key="Tbl.Dark.EntryName">#FFF0A6D0</Color>

  <!-- Light theme (editor background white) -->
  <Color x:Key="Tbl.Light.Text">#FF1E1E22</Color>
  <Color x:Key="Tbl.Light.Comment">#FF3D7A3D</Color>
  <Color x:Key="Tbl.Light.SectionHeader">#FF7A2E9E</Color>
  <Color x:Key="Tbl.Light.FieldName">#FF1F55A8</Color>
  <Color x:Key="Tbl.Light.String">#FFA3411F</Color>
  <Color x:Key="Tbl.Light.Number">#FF0B7765</Color>
  <Color x:Key="Tbl.Light.Keyword">#FF5A3FC0</Color>
  <Color x:Key="Tbl.Light.Brace">#FF66666E</Color>
  <Color x:Key="Tbl.Light.FileName">#FF8A5A00</Color>
  <Color x:Key="Tbl.Light.RefName">#FF00708F</Color>
  <Color x:Key="Tbl.Light.EntryName">#FFA0306E</Color>

  <!-- The stock panel stays installed (it highlights every match) but shows no chrome of its own. -->
  <Style TargetType="search:SearchPanel">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="search:SearchPanel">
          <Border Width="0" Height="0" Background="Transparent" IsHitTestVisible="False" Visibility="Collapsed" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TblCompletionWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource App.PaneBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border Background="{DynamicResource App.PaneBackground}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" SnapsToDevicePixels="True">
            <AdornerDecorator>
              <ContentPresenter />
            </AdornerDecorator>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TblCompletionListBox" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource App.PaneBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
            <ScrollViewer Focusable="False" Padding="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
          <Setter Property="Padding" Value="6,3" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Selection}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
