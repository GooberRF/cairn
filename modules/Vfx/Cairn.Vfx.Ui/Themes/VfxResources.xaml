<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Effects module styles. Brushes come from the shell theme (App.*), so both themes work. -->

  <!-- The inspector TabControl uses the shell's "PanelTabControl" style (set by resource reference in code). -->

  <!-- Fact label / value pairs in the read-only inspector tabs. -->
  <Style x:Key="Vfx.FactLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>
  <Style x:Key="Vfx.FactValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
</ResourceDictionary>
