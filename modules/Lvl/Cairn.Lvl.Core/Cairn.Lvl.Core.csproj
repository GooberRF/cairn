<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Cairn.Lvl</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Cairn.Formats\Cairn.Formats.csproj" />
    <ProjectReference Include="..\..\..\src\Cairn.Workspace\Cairn.Workspace.csproj" />
    <ProjectReference Include="..\..\..\src\Cairn.Assets\Cairn.Assets.csproj" />
    <!-- V3dMeshDescription / V3dBuilder / GltfSpace for the level converters. -->
    <ProjectReference Include="..\..\Rfa\Cairn.Rfa.Core\Cairn.Rfa.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Red Faction for N-Gage object table (XffObjectTable); the author confirms its rows. -->
    <EmbeddedResource Include="Convert\Resources\xff-objects.json" LogicalName="Cairn.Lvl.xff-objects.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cairn.Lvl.Tests" />
    <InternalsVisibleTo Include="Cairn.Lvl.Ui" />
  </ItemGroup>

</Project>
