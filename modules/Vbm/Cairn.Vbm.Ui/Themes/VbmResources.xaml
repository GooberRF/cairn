<!-- The bitmap module's resources: the frame strip's item template and list style (colours come from the theme). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Cairn.Vbm.Ui.Documents">

  <!-- One frame in the strip: the thumbnail on a checkerboard, its number below. The frame the preview shows (the
       playing one) gets an accent outline and a play mark before its number, apart from the selection highlight. -->
  <DataTemplate x:Key="Vbm.FrameTemplate" DataType="{x:Type local:VbmFrameItem}">
    <StackPanel Width="76" Margin="2,2,2,0" ToolTip="{Binding ToolTip}">
      <Border x:Name="Frame" Width="70" Height="70" HorizontalAlignment="Center" BorderThickness="2" BorderBrush="Transparent">
        <Border Background="{DynamicResource Preview.CheckerBrush}" BorderBrush="{DynamicResource App.SubtleBorder}" BorderThickness="1">
          <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
      </Border>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
        <Path x:Name="PlayMark" Data="M0,0 L7,4.5 L0,9 Z" Fill="{DynamicResource App.Accent}" Margin="0,0,4,0"
              VerticalAlignment="Center" Visibility="Collapsed" />
        <TextBlock x:Name="Number" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource App.SecondaryText}" />
      </StackPanel>
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter TargetName="PlayMark" Property="Visibility" Value="Visible" />
        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource App.Accent}" />
        <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
