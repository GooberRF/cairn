<Window x:Class="Cairn.Atx.Ui.Views.Dialogs.BulkTimingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cui="clr-namespace:Cairn.Ui.Controls;assembly=Cairn.Ui"
        xmlns:controls="clr-namespace:Cairn.Atx.Ui.Controls"
        Title="Bulk Frame Timing" Width="700" Height="600" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="120" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Style="{StaticResource DialogHeading}" Text="Bulk frame timing" />
      <TextBlock Style="{StaticResource HintText}"
                 Text="Retime many frames at once. Whatever you apply is a single Ctrl+Z." />
    </StackPanel>

    <!-- Scope -->
    <StackPanel Grid.Row="1" Style="{StaticResource DialogGroup}">
      <TextBlock Style="{StaticResource DialogSubheading}" Text="SCOPE" />
      <WrapPanel>
        <RadioButton GroupName="Scope" Margin="0,0,14,6"
                     IsChecked="{Binding IsScopeAll, Mode=TwoWay}"
                     ToolTip="Every frame in the file"
                     AutomationProperties.Name="All frames">
          <AccessText Text="_All frames" />
        </RadioButton>
        <RadioButton GroupName="Scope" Margin="0,0,14,6"
                     Content="{Binding SelectedScopeLabel}"
                     IsEnabled="{Binding HasSelection}"
                     IsChecked="{Binding IsScopeSelected, Mode=TwoWay}"
                     ToolTip="The frames highlighted in the frames list"
                     AutomationProperties.Name="Selected frames" />
        <RadioButton GroupName="Scope" Margin="0,0,14,6"
                     IsChecked="{Binding IsScopeRange, Mode=TwoWay}"
                     ToolTip="An inclusive run of frame indices"
                     AutomationProperties.Name="Index range">
          <AccessText Text="Index _range" />
        </RadioButton>
        <RadioButton GroupName="Scope" Margin="0,0,0,6"
                     IsChecked="{Binding IsScopeEveryNth, Mode=TwoWay}"
                     ToolTip="Every Nth frame, counting from an offset"
                     AutomationProperties.Name="Every Nth frame">
          <AccessText Text="Every _Nth" />
        </RadioButton>
      </WrapPanel>

      <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                  Visibility="{Binding ShowRange, Converter={StaticResource Truthy}}">
        <TextBlock Style="{StaticResource DialogLabel}" Text="From index" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <cui:NumericBox Decimals="0" Width="86" Value="{Binding RangeStart, Mode=TwoWay}"
                             Minimum="0" Maximum="{Binding MaxIndex}"
                             AutomationProperties.Name="Range start" />
        <TextBlock Style="{StaticResource DialogLabel}" Text="to" VerticalAlignment="Center"
                   Margin="10,0,8,0" />
        <cui:NumericBox Decimals="0" Width="86" Value="{Binding RangeEnd, Mode=TwoWay}"
                             Minimum="0" Maximum="{Binding MaxIndex}"
                             AutomationProperties.Name="Range end" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                  Visibility="{Binding ShowNth, Converter={StaticResource Truthy}}">
        <TextBlock Style="{StaticResource DialogLabel}" Text="Every" VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <cui:NumericBox Decimals="0" Width="72" Value="{Binding Nth, Mode=TwoWay}" Minimum="1" Maximum="99"
                             AutomationProperties.Name="Every N frames" />
        <TextBlock Style="{StaticResource DialogLabel}" Text="frames, starting at index"
                   VerticalAlignment="Center" Margin="10,0,8,0" />
        <cui:NumericBox Decimals="0" Width="72" Value="{Binding NthOffset, Mode=TwoWay}"
                             Minimum="0" Maximum="{Binding MaxIndex}"
                             AutomationProperties.Name="Starting index" />
      </StackPanel>
    </StackPanel>

    <!-- Operation -->
    <StackPanel Grid.Row="2" Style="{StaticResource DialogGroup}">
      <TextBlock Style="{StaticResource DialogSubheading}" Text="OPERATION" />
      <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="OperationBox" Width="196" MinHeight="30" SelectionChanged="OnOperationChanged"
                  ToolTip="What to do to every frame in scope"
                  AutomationProperties.Name="Operation" />

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                    Visibility="{Binding ShowValue, Converter={StaticResource Truthy}}">
          <TextBlock Style="{StaticResource DialogLabel}" Text="Time" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <cui:NumericBox Decimals="0" Width="110" Suffix="ms" Value="{Binding Value, Mode=TwoWay}"
                               Minimum="1" Maximum="600000" Step="10"
                               AutomationProperties.Name="Frame time in milliseconds" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                    Visibility="{Binding ShowPercent, Converter={StaticResource Truthy}}">
          <TextBlock Style="{StaticResource DialogLabel}" Text="Scale" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <cui:NumericBox Decimals="0" Width="110" Suffix="%" Value="{Binding PercentValue, Mode=TwoWay}"
                               Minimum="1" Maximum="10000" Step="5"
                               AutomationProperties.Name="Scale percent" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                    Visibility="{Binding ShowOffset, Converter={StaticResource Truthy}}">
          <TextBlock Style="{StaticResource DialogLabel}" Text="Change by" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <cui:NumericBox Decimals="0" Width="110" Suffix="ms" Value="{Binding Offset, Mode=TwoWay}"
                               Minimum="-600000" Maximum="600000" Step="10"
                               ToolTip="Negative numbers subtract"
                               AutomationProperties.Name="Milliseconds to add" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                    Visibility="{Binding ShowTotal, Converter={StaticResource Truthy}}">
          <TextBlock Style="{StaticResource DialogLabel}" Text="Total" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <cui:NumericBox Decimals="0" Width="120" Suffix="ms" Value="{Binding TotalMs, Mode=TwoWay}"
                               Minimum="1" Maximum="3600000" Step="50"
                               AutomationProperties.Name="Total duration in milliseconds" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="12,0,0,0"
                    Visibility="{Binding ShowRamp, Converter={StaticResource Truthy}}">
          <TextBlock Style="{StaticResource DialogLabel}" Text="From" VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <cui:NumericBox Decimals="0" Width="100" Suffix="ms" Value="{Binding FromMs, Mode=TwoWay}"
                               Minimum="1" Maximum="600000" Step="10"
                               AutomationProperties.Name="Ramp start" />
          <TextBlock Style="{StaticResource DialogLabel}" Text="to" VerticalAlignment="Center"
                     Margin="10,0,8,0" />
          <cui:NumericBox Decimals="0" Width="100" Suffix="ms" Value="{Binding ToMs, Mode=TwoWay}"
                               Minimum="1" Maximum="600000" Step="10"
                               AutomationProperties.Name="Ramp end" />
        </StackPanel>
      </StackPanel>
      <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Text="{Binding OperationHelp}" />
    </StackPanel>

    <!-- Before → after -->
    <Border Grid.Row="3" Style="{StaticResource DialogCard}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Table.HeaderBackground}" Padding="8,5"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="FRAME" />
            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="BEFORE" />
            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="" />
            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="AFTER" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Before and after">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="8,3">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="Transparent" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Changed}" Value="True">
                          <Setter Property="Background"
                                  Value="{DynamicResource Table.ChangedBackground}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="12"
                               Foreground="{DynamicResource App.SecondaryText}" />
                    <TextBlock Grid.Column="1" Text="{Binding BeforeText}" FontSize="12"
                               Foreground="{DynamicResource App.SecondaryText}" />
                    <TextBlock Grid.Column="2" Text="&#x2192;" FontSize="12"
                               Foreground="{DynamicResource App.SecondaryText}" />
                    <TextBlock Grid.Column="3" Text="{Binding AfterText}" FontSize="12"
                               Foreground="{DynamicResource App.Text}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="FontWeight" Value="Normal" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Changed}" Value="True">
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="4" Margin="0,10,0,0">
      <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource App.Text}"
                 AutomationProperties.Name="Summary" />
      <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                 Text="{Binding ValidationText}"
                 Visibility="{Binding HasValidation, Converter={StaticResource Truthy}}"
                 AutomationProperties.Name="Validation">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ValidationIsError}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Severity.Error}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ApplyButton" Style="{StaticResource DialogButton}" Content="_Apply"
              IsDefault="True" Click="OnApply" IsEnabled="{Binding CanApply}"
              AutomationProperties.Name="Apply" />
      <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True"
              AutomationProperties.Name="Cancel" />
    </StackPanel>
  </Grid>
</Window>
