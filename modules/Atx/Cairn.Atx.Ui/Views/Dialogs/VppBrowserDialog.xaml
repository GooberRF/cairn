<Window x:Class="Cairn.Atx.Ui.Views.Dialogs.VppBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Cairn.Atx.Ui.ViewModels"
        Title="Add Frames from VPP" Width="980" Height="700" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>

    <!-- A source group: the .atx's folder, a search folder, the game, or ad-hoc archives. -->
    <HierarchicalDataTemplate DataType="{x:Type vm:VppSourceNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" FontWeight="SemiBold"
                 Foreground="{DynamicResource App.Text}" Margin="0,2" MaxWidth="440"
                 TextTrimming="CharacterEllipsis"
                 AutomationProperties.Name="{Binding Description}" />
    </HierarchicalDataTemplate>

    <!-- One .vpp, with the tri-state box that ticks everything the filter is showing. -->
    <HierarchicalDataTemplate DataType="{x:Type vm:VppArchiveNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Margin="0,1">
        <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                  VerticalAlignment="Center" Margin="0,0,6,0"
                  Visibility="{Binding DataContext.IsAddFramesMode,
                               RelativeSource={RelativeSource AncestorType=Window},
                               Converter={StaticResource Truthy}}"
                  ToolTip="Tick or untick every image this archive is showing"
                  AutomationProperties.Name="{Binding ArchiveName}" />
        <!-- Archives with no images are never listed, so every row here has something to offer. -->
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                   Foreground="{DynamicResource App.Text}"
                   ToolTip="{Binding Description}"
                   AutomationProperties.Name="{Binding Description}" />
      </StackPanel>
    </HierarchicalDataTemplate>

    <!-- One image entry. -->
    <DataTemplate DataType="{x:Type vm:VppImageNodeViewModel}">
      <StackPanel Orientation="Horizontal" Margin="0,1">
        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"
                  Margin="0,0,6,0" ToolTip="{Binding Description}"
                  AutomationProperties.Name="{Binding Label}" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                   Foreground="{DynamicResource App.Text}" ToolTip="{Binding Description}" />
        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Severity.Warning}"
                   Visibility="{Binding IsNameTooLong, Converter={StaticResource Truthy}}"
                   ToolTip="This name is longer than the engine's 31-character limit"
                   AutomationProperties.Name="Name too long for the engine" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VppLoadingNodeViewModel}">
      <TextBlock Text="{Binding Label}" Style="{StaticResource HintText}" Margin="0,1" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VppEmptyNodeViewModel}">
      <TextBlock Text="{Binding Label}" Style="{StaticResource HintText}" Margin="0,1" />
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Heading -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource DialogHeading}" x:Name="Heading"
                 Text="Add frames from a .vpp archive" />
      <TextBlock Style="{StaticResource HintText}" x:Name="Subheading"
                 Text="Frames always store just the file name, so every image has to live somewhere the game will look." />
    </StackPanel>

    <!-- Tree | preview -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="320" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <!-- Left: filter + tree + selection line -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="8,0,0,0"
                  Content="_Open another .vpp…" Click="OnOpenArchive"
                  ToolTip="Browse an archive from anywhere on disk"
                  AutomationProperties.Name="Open another .vpp archive" />
          <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="4,0,0,0"
                  Command="{Binding ClearFilterCommand}"
                  Visibility="{Binding HasQuery, Converter={StaticResource Truthy}}"
                  ToolTip="Clear the filter" AutomationProperties.Name="Clear the filter">
            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
          </Button>
          <TextBox x:Name="FilterBox" MinHeight="30"
                   Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Filter by name across every archive (Ctrl+F). * and ? work as wildcards."
                   AutomationProperties.Name="Filter image names" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource DialogCard}" Padding="0">
          <Grid>
            <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0"
                      Background="Transparent"
                      SelectedItemChanged="OnTreeSelectionChanged"
                      PreviewKeyDown="OnTreeKeyDown"
                      PreviewMouseLeftButtonDown="OnTreeMouseDown"
                      MouseDoubleClick="OnTreeDoubleClick"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      AutomationProperties.Name="Archives and images">
              <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                  <!--
                    Virtualising panel at every level: a stock textures.vpp holds thousands of
                    entries and thirty of them on the search path would otherwise be ninety
                    thousand TreeViewItems the moment a filter matched.
                  -->
                  <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                </ItemsPanelTemplate>
              </TreeView.ItemsPanel>
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Select numbered _sequence"
                            Command="{Binding SelectSequenceCommand}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Tick the rest of this image's numbered run inside the same archive" />
                  <MenuItem Header="Select everything _shown in this archive"
                            Click="OnSelectAllVisible"
                            InputGestureText="Ctrl+A"
                            ToolTip="Tick every image the filter is showing in the focused archive" />
                  <Separator />
                  <MenuItem Header="_Clear selection" Command="{Binding ClearSelectionCommand}" />
                </ContextMenu>
              </TreeView.ContextMenu>
            </TreeView>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                        MaxWidth="360"
                        Visibility="{Binding IsTreeEmpty, Converter={StaticResource Truthy}}">
              <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource App.SecondaryText}" />
              <TextBlock Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,8,0,10"
                         TextWrapping="Wrap" Text="{Binding EmptyStateText}"
                         AutomationProperties.Name="Nothing to browse" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource DialogSmallButton}" Margin="0,0,8,0"
                        Content="_Set game directory…" Command="{Binding OpenSettingsCommand}"
                        ToolTip="Open Settings and point Cairn at Red Faction"
                        AutomationProperties.Name="Set the game directory" />
                <Button Style="{StaticResource DialogSmallButton}" Content="Open a _.vpp…"
                        Click="OnOpenArchive"
                        ToolTip="Browse an archive from anywhere on disk"
                        AutomationProperties.Name="Open a .vpp archive" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- What an archive the user opened by hand turned out to be, when it was nothing. -->
        <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap"
                   Style="{StaticResource InlineDiagnosticText}"
                   Foreground="{DynamicResource Severity.Warning}"
                   Text="{Binding AdHocNote}"
                   Visibility="{Binding HasAdHocNote, Converter={StaticResource Truthy}}"
                   AutomationProperties.Name="Opened archive note" />

        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
          <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                     Text="{Binding SelectionText}"
                     Foreground="{DynamicResource App.Text}"
                     Visibility="{Binding IsAddFramesMode, Converter={StaticResource Truthy}}"
                     AutomationProperties.Name="Selection count" />
          <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Margin="10,0,0,0"
                  Content="Clear" Command="{Binding ClearSelectionCommand}"
                  Visibility="{Binding HasSelection, Converter={StaticResource Truthy}}"
                  ToolTip="Untick every image"
                  AutomationProperties.Name="Clear the selection" />
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                     Style="{StaticResource HintText}" Text="{Binding ProgressText}"
                     Visibility="{Binding HasProgress, Converter={StaticResource Truthy}}"
                     AutomationProperties.Name="Loading progress" />
        </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}"
                    AutomationProperties.Name="Resize the preview" />

      <!-- Right: preview + facts -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DialogCard}" Padding="0" MinHeight="180"
                Background="{DynamicResource Preview.CheckerBrush}">
          <Grid>
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   Visibility="{Binding HasPreviewImage, Converter={StaticResource Truthy}}"
                   ToolTip="{Binding PreviewFacts}"
                   AutomationProperties.Name="Image preview" />
            <TextBlock Style="{StaticResource HintText}" TextAlignment="Center" Margin="16"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="{Binding PreviewPlaceholder}"
                       Visibility="{Binding HasPreviewImage, Converter={StaticResource Falsy}}"
                       AutomationProperties.Name="Preview status" />
          </Grid>
        </Border>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Text="{Binding PreviewFacts}"
                   Foreground="{DynamicResource App.SecondaryText}"
                   Visibility="{Binding HasPreviewFacts, Converter={StaticResource Truthy}}"
                   AutomationProperties.Name="Image facts" />

        <TextBlock Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                   Text="{Binding MismatchNote}"
                   Foreground="{DynamicResource Severity.Warning}"
                   Visibility="{Binding HasMismatchNote, Converter={StaticResource Truthy}}"
                   AutomationProperties.Name="Frame mismatch warning" />

        <!--
          An animated VBM added as a frame gives its frame 0 and nothing else, which is almost
          never what someone picking one wants. Say so where the decision is being made, and offer
          the thing that does what they meant.
        -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="10,8" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource App.Border}"
                Background="{DynamicResource App.ChromeBackground}"
                Visibility="{Binding CanImportFocusedAsAtx, Converter={StaticResource Truthy}}">
          <StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource App.SecondaryText}"
                       Text="{Binding ImportHintText}"
                       AutomationProperties.Name="Animated VBM hint" />
            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Content="Import as ATX…" Command="{Binding ImportAsAtxCommand}"
                    ToolTip="Close this browser and turn every frame of this VBM into an .atx"
                    AutomationProperties.Name="Import this VBM as an ATX" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Options -->
    <Grid Grid.Row="2" Margin="0,14,0,0" x:Name="Options">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,28,0">
        <TextBlock Style="{StaticResource DialogSubheading}" Text="INSERT" />
        <StackPanel Orientation="Horizontal">
          <RadioButton GroupName="Insert" Margin="0,0,14,0"
                       IsChecked="{Binding IsAfterSelection, Mode=TwoWay}"
                       ToolTip="Insert straight after the frames selected in the list"
                       AutomationProperties.Name="Insert after selection">
            <AccessText Text="After _selection" />
          </RadioButton>
          <RadioButton GroupName="Insert" Margin="0,0,14,0"
                       IsChecked="{Binding IsAtEnd, Mode=TwoWay}"
                       ToolTip="Append to the end of the frame list"
                       AutomationProperties.Name="Insert at end">
            <AccessText Text="At _end" />
          </RadioButton>
          <RadioButton GroupName="Insert"
                       IsChecked="{Binding IsReplaceAll, Mode=TwoWay}"
                       ToolTip="Throw away the current frames and use these instead — still one Ctrl+Z"
                       AutomationProperties.Name="Replace all frames">
            <AccessText Text="Replace _all frames" />
          </RadioButton>
        </StackPanel>
        <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                   Text="{x:Static vm:VppBrowserViewModel.OrderNote}"
                   AutomationProperties.Name="Frame order" />
      </StackPanel>

      <StackPanel Grid.Column="1">
        <TextBlock Style="{StaticResource DialogSubheading}" Text="HOW THE FRAMES FIND THE IMAGE" />
        <StackPanel Orientation="Horizontal">
          <RadioButton GroupName="Reference" Margin="0,0,14,0"
                       IsChecked="{Binding IsReferenceByName, Mode=TwoWay}"
                       ToolTip="Store just the name and let the game read it out of the .vpp"
                       AutomationProperties.Name="Reference by name">
            <AccessText Text="Reference by _name" />
          </RadioButton>
          <RadioButton GroupName="Reference" Margin="0,0,14,0"
                       IsChecked="{Binding IsExtract, Mode=TwoWay}"
                       IsEnabled="{Binding CanExtract}"
                       ToolTipService.ShowOnDisabled="True"
                       ToolTip="Write the images next to the .atx and refer to those files"
                       AutomationProperties.Name="Extract next to the .atx">
            <AccessText Text="E_xtract next to the .atx" />
          </RadioButton>
          <RadioButton GroupName="Reference"
                       IsChecked="{Binding IsAddFolderToSearch, Mode=TwoWay}"
                       Visibility="{Binding CanAddFolderToSearch, Converter={StaticResource Truthy}}"
                       ToolTip="Add the archive's folder to your search folders, then refer by name"
                       AutomationProperties.Name="Add this archive's folder to search folders">
            <AccessText Text="Add its _folder to search folders" />
          </RadioButton>
        </StackPanel>
        <CheckBox Margin="0,6,0,0" Content="Also e_xtract copies next to the .atx"
                  IsChecked="{Binding AlsoExtract, Mode=TwoWay}"
                  Visibility="{Binding CanAlsoExtract, Converter={StaticResource Truthy}}"
                  ToolTip="Write the images out as well, so they are there if the .vpp is not"
                  AutomationProperties.Name="Also extract copies next to the .atx" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="{Binding ReferenceHint}"
                   AutomationProperties.Name="What will happen" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{Binding ExtractBlockedText}"
                   Visibility="{Binding CanExtract, Converter={StaticResource Falsy}}"
                   AutomationProperties.Name="Why extraction is unavailable" />
      </StackPanel>
    </Grid>

    <!-- Buttons -->
    <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap"
                 MaxWidth="440" Style="{StaticResource InlineDiagnosticText}"
                 Foreground="{DynamicResource Severity.Warning}"
                 Text="{Binding NameTooLongText}"
                 Visibility="{Binding HasNameTooLong, Converter={StaticResource Truthy}}"
                 AutomationProperties.Name="Names too long for the engine" />
      <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Cancel"
              IsCancel="True" AutomationProperties.Name="Cancel" />
      <Button DockPanel.Dock="Right" x:Name="OkButton" Style="{StaticResource DialogButton}"
              x:FieldModifier="private" Content="_Add frames" IsDefault="True" Click="OnOk"
              IsEnabled="{Binding CanApply}"
              ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Blocker}"
              AutomationProperties.Name="Add frames" />
      <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                 MaxWidth="280" TextWrapping="Wrap" Style="{StaticResource HintText}"
                 Text="{Binding Blocker}"
                 Visibility="{Binding Blocker, Converter={StaticResource Truthy}}"
                 AutomationProperties.Name="Why this is disabled" />
    </DockPanel>
  </Grid>
</Window>
