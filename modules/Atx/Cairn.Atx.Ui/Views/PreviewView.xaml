<!--
  PREVIEW — the animated player.

  DataContext is the active DocumentViewModel; everything below binds through its Preview
  view-model, which owns the AtxPlayback controller and the composited frames. The canvas, the
  transport, the scrubber and the toggles are all here; the code-behind only does the things layout
  cannot: the render loop, zoom-to-fit arithmetic, wheel zoom and drag panning.
-->
<UserControl x:Class="Cairn.Atx.Ui.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cairn.Atx.Ui.Controls"
             Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
             AutomationProperties.Name="Preview player">
  <UserControl.Resources>
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="Height" Value="28" />
    </Style>
    <Style x:Key="TransportGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="ToggleChip" TargetType="ToggleButton" BasedOn="{StaticResource FilterToggle}">
      <Setter Property="Height" Value="24" />
    </Style>
  </UserControl.Resources>

  <Grid DataContext="{Binding Preview}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="60" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Pane header + view toggles -->
    <Border Grid.Row="0" Style="{StaticResource PaneHeaderBorder}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="PREVIEW" Style="{StaticResource PaneHeaderText}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <ToggleButton Style="{StaticResource ToggleChip}"
                        IsChecked="{Binding SimulateFormat, Mode=TwoWay}"
                        ToolTip="Show each frame quantised to the pixel format the game will store it in"
                        AutomationProperties.Name="Simulate target format">
            <TextBlock Text="Format" FontSize="11" />
          </ToggleButton>
          <ToggleButton Style="{StaticResource ToggleChip}" IsChecked="{Binding Tile, Mode=TwoWay}"
                        ToolTip="Draw the frame three by three to check the seams"
                        AutomationProperties.Name="Tile three by three">
            <TextBlock Text="Tile" FontSize="11" />
          </ToggleButton>
          <ToggleButton Style="{StaticResource ToggleChip}" Margin="0"
                        IsChecked="{Binding ShowAlphaOnly, Mode=TwoWay}"
                        ToolTip="Show the transparency channel as grey instead of the colour"
                        AutomationProperties.Name="Show alpha only">
            <TextBlock Text="Alpha" FontSize="11" />
          </ToggleButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The canvas -->
    <Border Grid.Row="1" x:Name="PlayerHost" ClipToBounds="True"
            Background="{DynamicResource Preview.Background}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          The Static-mode explanation lives inside the canvas, not in a row of its own: the
          transport and the readout must never lose height to an explanation, and the picture is
          the thing that can afford to give a little.
        -->
        <Border Grid.Row="0" Margin="6,6,6,0" Padding="8,3" CornerRadius="4"
                BorderThickness="1"
                Background="{DynamicResource Banner.InfoBackground}"
                BorderBrush="{DynamicResource Banner.InfoBorder}"
                ToolTip="{Binding StaticNoticeDetail}"
                Visibility="{Binding ShowStaticNotice, Converter={StaticResource Truthy}}"
                AutomationProperties.Name="{Binding StaticNoticeDetail}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,1" VerticalAlignment="Center"
                    Content="Force loop" Command="{Binding ForceLoopCommand}"
                    ToolTip="Play the frames in the preview anyway; the file is not changed"
                    AutomationProperties.Name="Force loop" />
            <!-- Wraps rather than truncating: the pane is often narrow enough to swallow the end
                 of the sentence, and half a sentence explains nothing. -->
            <TextBlock Text="{Binding StaticNoticeText}" FontSize="11"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource Banner.Foreground}" />
          </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="Viewport" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Padding="0" Focusable="False"
                      Visibility="{Binding HasImage, Converter={StaticResource Truthy}}">
          <Grid x:Name="Stage" Margin="10">
            <Border x:Name="Surface" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <UniformGrid x:Name="Tiles" Rows="1" Columns="1">
                <Image x:Name="FrameImage" Stretch="Fill"
                       AutomationProperties.Name="Composited frame" />
              </UniformGrid>
            </Border>
          </Grid>
        </ScrollViewer>

        <!--
          Missing or undecodable frame, or nothing selected yet. Laid out side by side rather than
          stacked: the canvas is often only a hundred pixels tall, and a message that explains which
          file is missing is no use if it is the part that gets clipped.
        -->
        <Border Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="8" Padding="10,8" CornerRadius="4" MaxWidth="300"
                Background="{DynamicResource App.PaneBackground}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                Visibility="{Binding HasPlaceholder, Converter={StaticResource Truthy}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets"
                       FontSize="18" VerticalAlignment="Top" Margin="0,0,10,0"
                       Foreground="{DynamicResource App.SecondaryText}" />
            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center"
                       Text="{Binding PlaceholderText}"
                       ToolTip="{Binding PlaceholderText}"
                       AutomationProperties.Name="{Binding PlaceholderText}" />
          </DockPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Transport -->
    <Grid Grid.Row="2" Margin="8,6,8,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <controls:FrameScrubber x:Name="Scrubber" Grid.Row="0"
                              Weights="{Binding ScrubberWeights}"
                              CurrentIndex="{Binding CurrentIndex, Mode=OneWay}"
                              SelectedIndex="{Binding SelectedIndex, Mode=OneWay}" />

      <!--
        A WrapPanel, not a DockPanel: the middle pane is often narrow, and a transport row that
        silently clips its own speed and zoom pickers would be worse than one that takes two lines.
      -->
      <WrapPanel Grid.Row="1" Margin="0,4,0,0" Orientation="Horizontal">
        <StackPanel Orientation="Horizontal" Margin="0,4,10,0">
          <Button Style="{StaticResource TransportButton}"
                  Command="{Binding FirstCommand}" ToolTip="First frame"
                  AutomationProperties.Name="First frame">
            <TextBlock Text="&#xE892;" Style="{StaticResource TransportGlyph}" />
          </Button>
          <Button Style="{StaticResource TransportButton}"
                  Command="{Binding PreviousCommand}" ToolTip="Previous frame"
                  AutomationProperties.Name="Previous frame">
            <TextBlock Text="&#xE76B;" Style="{StaticResource TransportGlyph}" />
          </Button>
          <Button Style="{StaticResource TransportButton}" MinWidth="38"
                  Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayTooltip}"
                  AutomationProperties.Name="{Binding PlayAutomationName}">
            <TextBlock Text="{Binding PlayGlyph}" Style="{StaticResource TransportGlyph}" FontSize="13" />
          </Button>
          <Button Style="{StaticResource TransportButton}"
                  Command="{Binding NextCommand}" ToolTip="Next frame"
                  AutomationProperties.Name="Next frame">
            <TextBlock Text="&#xE76C;" Style="{StaticResource TransportGlyph}" />
          </Button>
          <Button Style="{StaticResource TransportButton}"
                  Command="{Binding LastCommand}" ToolTip="Last frame"
                  AutomationProperties.Name="Last frame">
            <TextBlock Text="&#xE893;" Style="{StaticResource TransportGlyph}" />
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <ComboBox x:Name="ModeBox" Width="124" MinHeight="30" Margin="0,0,6,0"
                    IsEditable="False"
                    SelectionChanged="OnModeChanged"
                    ToolTip="Follow the file's animation mode, or loop the frames whatever it says"
                    AutomationProperties.Name="Preview animation mode" />
          <ComboBox x:Name="SpeedBox" Width="78" MinHeight="30" Margin="0,0,6,0"
                    IsEditable="False"
                    SelectionChanged="OnSpeedChanged"
                    ToolTip="Playback speed. The file's frame times are unchanged."
                    AutomationProperties.Name="Playback speed" />
          <ComboBox x:Name="ZoomBox" Width="86" MinHeight="30"
                    IsEditable="False"
                    SelectionChanged="OnZoomChanged"
                    ToolTip="Zoom. Ctrl+mouse wheel over the picture does the same."
                    AutomationProperties.Name="Zoom" />
        </StackPanel>
      </WrapPanel>
    </Grid>

    <!-- Readout -->
    <Border Grid.Row="3" Margin="0,6,0,0" Background="{DynamicResource App.ChromeBackground}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="8,4">
      <TextBlock Text="{Binding ReadoutText}" FontSize="11" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource App.SecondaryText}"
                 ToolTip="{Binding ReadoutText}"
                 AutomationProperties.Name="Preview details" />
    </Border>
  </Grid>
</UserControl>
