<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- The libraries reference WPF (imaging only); the generator must match. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Cairn.Rfa.SampleGen</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\modules\Rfa\Cairn.Rfa.Core\Cairn.Rfa.Core.csproj" />
  </ItemGroup>

</Project>
