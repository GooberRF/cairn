<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- The libraries reference WPF (imaging only); the generator must match. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Cairn.Vfx.SampleGen</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\modules\Vfx\Cairn.Vfx.Core\Cairn.Vfx.Core.csproj" />
    <ProjectReference Include="..\..\src\Cairn.Formats\Cairn.Formats.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The templates and primitive requests are the editor's own (pure Core edits, no UI types). -->
    <Compile Include="..\..\modules\Vfx\Cairn.Vfx.Ui\Dialogs\VfxCreation.cs" Link="Shared\VfxCreation.cs" />
  </ItemGroup>

</Project>
