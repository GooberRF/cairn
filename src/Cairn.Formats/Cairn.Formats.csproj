<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <!-- WPF is referenced for System.Windows.Media.Imaging (PNG/JPEG pixel decode) only.
         No UI types live in this assembly. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Cairn.Formats</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ogg Vorbis decoding for audio facts and previews (Audio/). -->
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- Block compression and mip generation for the DDS converter (Imaging/DdsEncoder). -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ogg Vorbis encoding (Audio/OggVorbisWriter): libvorbis 1.3.7 + libogg 1.3.5, BSD-3-Clause, built from the
         official Xiph.Org releases by native/vorbis/build.ps1. Copied next to every program that references this
         project; the single-file publish bundles it (IncludeNativeLibrariesForSelfExtract). -->
    <None Include="..\..\native\vorbis\win-x64\cairn-vorbis.dll" Link="cairn-vorbis.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- GltfWriter saves through AtomicFile (write to a temporary file, then replace). -->
    <ProjectReference Include="..\Cairn.Workspace\Cairn.Workspace.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module test projects drive a few internal seams directly (for example the injected
         registry reader behind GameDirectoryLocator). Nothing else is opened up. -->
    <InternalsVisibleTo Include="Cairn.Rfa.Tests" />
    <!-- Seams Cairn.Rfa.Core used while it was one assembly with these libraries. -->
    <InternalsVisibleTo Include="Cairn.Rfa.Core" />
    <InternalsVisibleTo Include="Cairn.Atx.Tests" />
    <InternalsVisibleTo Include="Cairn.Vfx.Tests" />
  </ItemGroup>

</Project>
