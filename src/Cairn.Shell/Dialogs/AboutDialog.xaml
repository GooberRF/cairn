<Window x:Class="Cairn.Shell.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Cairn" Width="760" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!--
    The notices are an always-visible panel in a box that owns its scroll bar, so the wheel, the
    keyboard and the bar agree; the width suits the hard-wrapped licence and notices files.
  -->
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource DialogHeading}" FontSize="20" Text="Cairn" />
      <TextBlock x:Name="VersionText" Style="{StaticResource HintText}"
                 AutomationProperties.Name="Version" />
    </StackPanel>

    <TextBlock Grid.Row="1" Margin="0,14,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource App.Text}"
               Text="A workbench for viewing and editing Red Faction game files. Each file type comes from a module; the shell provides the tabs, files, recovery, settings and help they share." />

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Text="MIT licensed. Copyright © 2026 Chris &quot;Goober&quot; Parsons."
                 Foreground="{DynamicResource App.Text}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Text="Made for the Red Faction community; see " VerticalAlignment="Center"
                   Foreground="{DynamicResource App.SecondaryText}" />
        <Button x:Name="SiteLink" Style="{StaticResource LinkButton}" Content="alpinefaction.com"
                Click="OnOpenSite"
                ToolTip="Opens https://alpinefaction.com in your browser"
                AutomationProperties.Name="Open the Alpine Faction website" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="3" Margin="0,16,0,6" Style="{StaticResource DialogSubheading}"
               Text="LICENCE AND THIRD-PARTY NOTICES" />

    <Border Grid.Row="4" Style="{StaticResource DialogCard}" Padding="2">
      <TextBox x:Name="NoticesText" Height="250"
               IsReadOnly="True" IsReadOnlyCaretVisible="True" IsUndoEnabled="False"
               AcceptsReturn="False" TextWrapping="Wrap" TextAlignment="Left"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               BorderThickness="0" Background="Transparent" Padding="8,6"
               Foreground="{DynamicResource App.Text}"
               FontFamily="{DynamicResource MonoFont}" FontSize="11.5"
               ToolTip="Select any part of this text and press Ctrl+C to copy it"
               AutomationProperties.Name="Licence and third-party notices">
        <TextBox.Resources>
          <Style TargetType="ScrollBar" BasedOn="{StaticResource PaneScrollBar}" />
        </TextBox.Resources>
      </TextBox>
    </Border>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="CloseButton" Style="{StaticResource DialogButton}" Content="Close"
              IsDefault="True" IsCancel="True" Click="OnClose"
              ToolTip="Close this window"
              AutomationProperties.Name="Close" />
    </StackPanel>
  </Grid>
</Window>
