<UserControl x:Class="Cairn.Shell.Dialogs.AssociationsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Truthy" />
  </UserControl.Resources>
  <StackPanel>
    <StackPanel Style="{StaticResource DialogGroup}">
      <TextBlock Style="{StaticResource DialogSubheading}" Text="OPEN THESE FILE TYPES WITH CAIRN" />
      <TextBlock Style="{StaticResource HintText}"
                 Text="Ticked types open with this copy of Cairn when you double-click them in Explorer. Changes are made when you press OK, for your Windows account only, and need no administrator rights. Unticking a type puts back the program Cairn replaced." />
      <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0" Foreground="{DynamicResource Severity.Warning}"
                 Text="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource Truthy}}"
                 AutomationProperties.Name="File associations problem" />

      <Border Style="{StaticResource DialogCard}" Padding="0,4,0,6" Margin="0,10,0,0" IsEnabled="{Binding IsAvailable}">
        <StackPanel Grid.IsSharedSizeScope="True">
          <Grid Margin="12,4,12,2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="Extension" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="Check" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderText}" Text="Type" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderText}" Text="Description" Margin="0,0,12,0" />
            <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderText}" Text="Opens now with" Margin="0,0,12,0" />
            <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderText}" Text="Open with Cairn" />
          </Grid>
          <ItemsControl x:Name="List" Focusable="False" KeyboardNavigation.TabNavigation="Continue"
                        AutomationProperties.Name="File types">
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource App.SubtleBorder}" Margin="0,6,0,0" Padding="12,6,12,2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="12,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="Extension" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Check" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource MonoText}" Text="{Binding Extension}"
                             VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource App.Text}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                             ToolTip="{Binding Kind.FriendlyName}" />
                  <TextBlock Grid.Column="2" Text="{Binding OwnerText}" Foreground="{DynamicResource App.SecondaryText}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                             ToolTip="{Binding OwnerTip}" AutomationProperties.Name="{Binding OwnerTip}" />
                  <CheckBox Grid.Column="3" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsChecked="{Binding OpenWithCairn, Mode=TwoWay}"
                            ToolTip="{Binding CheckTip}" AutomationProperties.Name="{Binding CheckTip}" />
                  <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4,0,2"
                             Visibility="{Binding HasNote, Converter={StaticResource Truthy}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DialogSmallButton}" Margin="0" Content="Choose default…"
                            Command="{Binding DataContext.ChooseDefaultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            ToolTip="{Binding ChooseTip}" AutomationProperties.Name="{Binding ChooseTip}" />
                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Severity.Warning}" FontSize="11"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                  </DockPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Style="{StaticResource DialogSmallButton}" Content="Select _all" Command="{Binding SelectAllCommand}"
                ToolTip="Tick every file type (applied when you press OK)" AutomationProperties.Name="Select all file types" />
        <Button Style="{StaticResource DialogSmallButton}" Content="Select _none" Command="{Binding SelectNoneCommand}"
                ToolTip="Untick every file type (applied when you press OK)" AutomationProperties.Name="Select no file types" />
      </StackPanel>
    </StackPanel>

    <StackPanel Style="{StaticResource DialogGroup}">
      <TextBlock Style="{StaticResource DialogSubheading}" Text="OLDER APPS" />
      <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                 Text="RFA Workbench and ATX Workbench registered .rfa, .v3c and .atx for themselves. Cairn leaves those entries alone unless you remove them here (this asks first and acts at once)." />
      <Button Style="{StaticResource DialogSmallButton}" HorizontalAlignment="Left" Content="Remove _old RFA/ATX Workbench associations…"
              Command="{Binding RemoveOldAppsCommand}"
              ToolTip="Remove only the associations RFA Workbench and ATX Workbench made for your account (asks first)"
              AutomationProperties.Name="Remove old RFA and ATX Workbench associations" />
    </StackPanel>
  </StackPanel>
</UserControl>
