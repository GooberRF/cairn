<Window x:Class="Cairn.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cairn.Shell"
        Title="{Binding WindowTitle}" Height="900" Width="1500" MinWidth="960" MinHeight="600"
        Icon="app.ico"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True">

  <Window.Resources>
    <Style x:Key="ToolbarGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    </Style>
    <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,3" />
      <Setter Property="Fill" Value="{DynamicResource App.Border}" />
    </Style>

    <!-- The tab strip only (each document's view lives in DocumentHost), with a generic "open" button on the right. -->
    <Style x:Key="ShellDocumentTabControl" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Border Background="{DynamicResource App.ChromeBackground}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="4,2,6,2" VerticalAlignment="Center"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Open a file (Ctrl+O)" AutomationProperties.Name="Open a file">
                  <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="6,0,0,0">
                  <TabPanel IsItemsHost="True" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="4,2" Background="{DynamicResource App.ChromeBackground}" AutomationProperties.Name="Main menu" />

    <!-- Slim toolbar: shell buttons, pane toggles, then module contributions -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource App.ChromeBackground}" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="0,0,0,1" Padding="6,3">
      <StackPanel x:Name="ToolbarPanel" Orientation="Horizontal">
        <!-- New: split button (default kind = the active document's module, else the first creatable kind; the arrow lists every kind) -->
        <StackPanel x:Name="NewSplit" Orientation="Horizontal">
          <Button x:Name="NewButton" Style="{StaticResource ToolButton}" Click="OnNewDefault" AutomationProperties.Name="New document">
            <TextBlock Text="&#xE8A5;" Style="{StaticResource ToolbarGlyph}" />
          </Button>
          <Button x:Name="NewMenuButton" Style="{StaticResource ToolButton}" Click="OnNewMenu" Padding="1,0" MinWidth="14" Margin="0,0,2,0"
                  ToolTip="New: choose the kind of document" AutomationProperties.Name="Choose the kind of new document">
            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
        <Button Style="{StaticResource ToolButton}" Command="{Binding OpenCommand}" ToolTip="Open… (Ctrl+O)" AutomationProperties.Name="Open a file">
          <TextBlock Text="&#xE8E5;" Style="{StaticResource ToolbarGlyph}" />
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save">
          <TextBlock Text="&#xE74E;" Style="{StaticResource ToolbarGlyph}" />
        </Button>
        <Rectangle Style="{StaticResource ToolbarSeparator}" />
        <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo">
          <TextBlock Text="&#xE7A7;" Style="{StaticResource ToolbarGlyph}" />
        </Button>
        <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
          <TextBlock Text="&#xE7A6;" Style="{StaticResource ToolbarGlyph}" />
        </Button>
        <Rectangle x:Name="PaneToggleSeparator" Style="{StaticResource ToolbarSeparator}" />
        <ToggleButton x:Name="LeftPaneToggle" Style="{StaticResource ToolToggle}" Margin="0,0,2,0"
                      Click="OnLeftPaneToggle" ToolTip="Show or hide the left pane (Ctrl+Shift+L)" AutomationProperties.Name="Toggle the left pane">
          <TextBlock Text="&#xE90C;" Style="{StaticResource ToolbarGlyph}" />
        </ToggleButton>
        <ToggleButton x:Name="BottomPaneToggle" Style="{StaticResource ToolToggle}"
                      Click="OnBottomPaneToggle" ToolTip="Show or hide the bottom pane (Ctrl+Shift+M)" AutomationProperties.Name="Toggle the bottom pane">
          <TextBlock Text="&#xE90E;" Style="{StaticResource ToolbarGlyph}" />
        </ToggleButton>
        <Rectangle x:Name="ModuleToolbarSeparator" Style="{StaticResource ToolbarSeparator}" />
      </StackPanel>
    </Border>

    <!-- Status bar: shell message on the left, the active document's StatusItems on the right -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource App.ChromeBackground}" BorderBrush="{DynamicResource App.Border}"
            BorderThickness="0,1,0,0" Padding="4,2" AutomationProperties.Name="Status bar">
      <DockPanel Height="22">
        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding StatusItems}" Focusable="False" Margin="12,0,6,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <!-- As the old apps: plain text items, clickable ones (error/warning counts...) as flat buttons; a thin separator between items -->
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Rectangle x:Name="Sep" Width="1" Height="14" Margin="6,0" VerticalAlignment="Center" Fill="{DynamicResource App.Border}" />
                <Button x:Name="Btn" Style="{StaticResource StatusButton}" Content="{Binding Text}" ToolTip="{Binding ToolTip}" Command="{Binding Command}"
                        AutomationProperties.Name="{Binding Text}" />
                <TextBlock x:Name="Txt" Visibility="Collapsed" Text="{Binding Text}" ToolTip="{Binding ToolTip}" Style="{StaticResource StatusText}"
                           Margin="2,0" AutomationProperties.Name="{Binding Text}" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                  <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Command}" Value="{x:Null}">
                  <Setter TargetName="Btn" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Txt" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding StatusText}" AutomationProperties.Name="Status message" />
      </DockPanel>
    </Border>

    <!-- Content: tab strip across the window; left pane | document (or welcome); bottom pane across the window -->
    <Grid x:Name="BodyGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="200" />
        <RowDefinition x:Name="BottomSplitterRow" Height="Auto" />
        <RowDefinition x:Name="BottomRow" Height="220" MinHeight="80" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="280" MinWidth="160" />
        <ColumnDefinition x:Name="LeftSplitterColumn" Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="420" />
      </Grid.ColumnDefinitions>

      <TabControl x:Name="DocumentTabs" Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource ShellDocumentTabControl}"
                  ItemContainerStyle="{StaticResource DocumentTabItem}"
                  ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                  Visibility="{Binding HasDocuments, Converter={StaticResource Truthy}}" AutomationProperties.Name="Open documents">
        <TabControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding TabHeader}" ToolTip="{Binding TabToolTip}" />
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate />
        </TabControl.ContentTemplate>
      </TabControl>

      <Border x:Name="LeftPane" Grid.Row="1" Grid.Column="0" Margin="6,6,0,0" Style="{StaticResource PaneBorder}">
        <TabControl x:Name="LeftTabs" Style="{StaticResource PanelTabControl}" ItemContainerStyle="{StaticResource PanelTabItem}"
                    AutomationProperties.Name="Left pane" />
      </Border>
      <GridSplitter x:Name="LeftSplitter" Grid.Row="1" Grid.Column="1" Style="{StaticResource VerticalSplitter}" ResizeBehavior="PreviousAndNext"
                    ToolTip="Drag to resize the left pane" AutomationProperties.Name="Resize the left pane" />

      <Grid Grid.Row="1" Grid.Column="2">
        <ContentControl x:Name="DocumentHost" Focusable="False" Content="{Binding ActiveView}" AutomationProperties.Name="Active document" />
        <local:WelcomeView x:Name="Welcome" Visibility="{Binding HasDocuments, Converter={StaticResource Falsy}}" />
      </Grid>

      <GridSplitter x:Name="BottomSplitter" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource HorizontalSplitter}"
                    ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                    ToolTip="Drag to resize the bottom pane" AutomationProperties.Name="Resize the bottom pane" />
      <Border x:Name="BottomPane" Grid.Row="3" Grid.ColumnSpan="3" Margin="6,0,6,6" Style="{StaticResource PaneBorder}">
        <TabControl x:Name="BottomTabs" Style="{StaticResource PanelTabControl}" ItemContainerStyle="{StaticResource PanelTabItem}"
                    AutomationProperties.Name="Bottom pane" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
