<UserControl x:Class="Cairn.Shell.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cairn.Shell"
             Background="{DynamicResource App.WindowBackground}"
             AutomationProperties.Name="Welcome">
  <UserControl.Resources>
    <Style x:Key="WelcomeGlyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource PaneHeaderText}">
      <Setter Property="Margin" Value="0,22,0,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <Border MaxWidth="620" MinWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
            Padding="32,28" Style="{StaticResource PaneBorder}">
      <StackPanel>
        <TextBlock Text="Cairn" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource App.Text}" />
        <TextBlock x:Name="Summary" Style="{StaticResource HintText}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <!-- Open and settings: always available -->
        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
          <Button Padding="14,7" Margin="0,0,10,0" Command="{Binding OpenCommand}"
                  ToolTip="Open one or more files (Ctrl+O)" AutomationProperties.Name="Open a file">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8E5;" Style="{StaticResource WelcomeGlyph}" />
              <TextBlock Text="Open…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Padding="14,7" Click="OnSettings"
                  ToolTip="Theme, game directory, search folders and module settings" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" Style="{StaticResource WelcomeGlyph}" />
              <TextBlock Text="Settings…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- New: one button per creatable kind, grouped by module -->
        <StackPanel x:Name="NewSection">
          <TextBlock Text="NEW" Style="{StaticResource SectionHeader}" />
          <ItemsControl x:Name="NewGroups" Focusable="False" AutomationProperties.Name="New file types">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WelcomeGroup}">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="{Binding Module}" Style="{StaticResource HintText}" />
                  <ItemsControl ItemsSource="{Binding Kinds}" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:WelcomeKind}">
                        <Button Padding="12,5" Margin="0,4,8,0"
                                Command="{Binding DataContext.NewCommand, RelativeSource={RelativeSource AncestorType=local:WelcomeView}}"
                                CommandParameter="{Binding Kind}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource WelcomeGlyph}" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Recent files -->
        <StackPanel x:Name="RecentSection">
          <TextBlock Text="RECENT" Style="{StaticResource SectionHeader}" />
          <ItemsControl x:Name="RecentList" Margin="0,6,0,0" Focusable="False" AutomationProperties.Name="Recent files">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WelcomeRecent}">
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Padding="0,3"
                        Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=local:WelcomeView}}"
                        CommandParameter="{Binding Path}" ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Folder}" Margin="10,0,0,0" FontSize="11" Opacity="0.65"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Drop hint -->
        <Border Margin="0,22,0,0" Padding="16,14" CornerRadius="4" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                Background="{DynamicResource App.ChromeBackground}">
          <DockPanel HorizontalAlignment="Center">
            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource App.SecondaryText}" />
            <TextBlock x:Name="DropHint" Style="{StaticResource HintText}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <!-- Loaded modules and the files they handle -->
        <TextBlock Text="MODULES" Style="{StaticResource SectionHeader}" />
        <ItemsControl x:Name="ModuleList" Margin="0,6,0,0" Focusable="False" AutomationProperties.Name="Loaded modules">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:WelcomeModule}">
              <StackPanel Margin="0,3">
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource App.Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Handles}" Style="{StaticResource HintText}" TextWrapping="Wrap" TextAlignment="Left"
                           HorizontalAlignment="Left" Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoModules" Text="No modules are loaded, so no file types can be opened." Style="{StaticResource HintText}" Margin="0,6,0,0" />

        <TextBlock Style="{StaticResource HintText}" Margin="0,18,0,0" Text="Press F1 for the keyboard shortcuts." />
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
