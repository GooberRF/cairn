<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Cairn.Ui</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- WPF0001: ThemeService follows Windows' Fluent ThemeMode, as before. -->
    <NoWarn>$(NoWarn);CS1591;WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cairn.Formats\Cairn.Formats.csproj" />
    <ProjectReference Include="..\Cairn.Workspace\Cairn.Workspace.csproj" />
    <ProjectReference Include="..\Cairn.Assets\Cairn.Assets.csproj" />
  </ItemGroup>

</Project>
