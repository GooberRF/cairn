<Window x:Class="Cairn.Ui.Controls.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="Height" Width="520" ShowInTaskbar="False"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Grid.Row="0" FontSize="16" FontWeight="SemiBold"
               TextWrapping="Wrap" Foreground="{DynamicResource App.Text}"
               AutomationProperties.Name="Heading" />

    <TextBlock x:Name="BodyText" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource App.Text}" AutomationProperties.Name="Message" />

    <Border x:Name="ItemsBox" Grid.Row="2" Margin="0,12,0,0" Padding="10,8" Visibility="Collapsed"
            Background="{DynamicResource App.PaneBackground}"
            BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="4">
      <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ItemsList" AutomationProperties.Name="Affected files">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Margin="0,1" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding}" Foreground="{DynamicResource App.Text}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Expander x:Name="DetailsBox" Grid.Row="3" Margin="0,12,0,0" Header="Technical details"
              Visibility="Collapsed" Foreground="{DynamicResource App.Text}"
              AutomationProperties.Name="Technical details">
      <ScrollViewer MaxHeight="200" Margin="0,6,0,0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <TextBox x:Name="DetailsText" IsReadOnly="True" BorderThickness="0"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 Background="Transparent" Foreground="{DynamicResource App.SecondaryText}"
                 AutomationProperties.Name="Technical details text" />
      </ScrollViewer>
    </Expander>

    <StackPanel x:Name="ButtonRow" Grid.Row="4" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,20,0,0" />
  </Grid>
</Window>
