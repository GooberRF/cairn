<UserControl x:Class="Cairn.Ui.Controls.SplitToolButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="False">
  <StackPanel Orientation="Horizontal">
    <!--
      Two ordinary buttons rather than one control with a hit-test split: both are tab stops, both
      take Space and Enter, and both pick up the ToolButton chrome, so the pair behaves like the
      rest of the toolbar without a custom template to keep in step with it.
    -->
    <Button x:Name="Primary" Style="{DynamicResource ToolButton}"
            Command="{Binding PrimaryCommand, ElementName=Root}"
            IsEnabled="{Binding IsActionEnabled, ElementName=Root}"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="{Binding PrimaryToolTip, ElementName=Root}"
            AutomationProperties.Name="{Binding PrimaryLabel, ElementName=Root}">
      <TextBlock Text="{Binding Glyph, ElementName=Root}" FontFamily="Segoe MDL2 Assets"
                 FontSize="{Binding GlyphSize, ElementName=Root}" />
    </Button>
    <Button x:Name="Arrow" Style="{DynamicResource ToolButton}" MinWidth="16" Padding="2,0"
            Margin="-2,0,0,0" Click="OnArrowClick"
            IsEnabled="{Binding IsActionEnabled, ElementName=Root}"
            ToolTipService.ShowOnDisabled="True"
            ToolTip="{Binding MenuToolTip, ElementName=Root}"
            AutomationProperties.Name="{Binding MenuToolTip, ElementName=Root}">
      <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                 Foreground="{DynamicResource App.SecondaryText}" />
    </Button>
  </StackPanel>
</UserControl>
