<!--
  Shared control styles. Colours come only from the theme-keyed brushes in Light.xaml / Dark.xaml,
  referenced with DynamicResource so a runtime theme swap repaints without rebuilding the tree.
  Spacing follows an 8px grid (4px for tight pairings).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- A focus ring that is visible in both themes; every custom template opts into it. -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="1" SnapsToDevicePixels="True" RadiusX="3" RadiusY="3"
                     Stroke="{DynamicResource App.Accent}" StrokeThickness="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Text ──────────────────────────────────────────────────────────────── -->

  <Style x:Key="PaneHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!--
    A label in a two-column form: the label sits to the left of its control and every label in the
    form shares one column width, so the controls line up. Labels are short by design and are never
    trimmed — a form that ellipsises its own labels reads as broken.
  -->
  <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="None" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <Style x:Key="HintText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="InlineDiagnosticText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- ── Panels ────────────────────────────────────────────────────────────── -->

  <Style x:Key="PaneBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource App.PaneBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style x:Key="PaneHeaderBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource App.ChromeBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style x:Key="VerticalSplitter" TargetType="GridSplitter">
    <Setter Property="Width" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="Resize panes" />
    <Setter Property="ToolTip" Value="Drag to resize the panes" />
  </Style>

  <Style x:Key="HorizontalSplitter" TargetType="GridSplitter">
    <Setter Property="Height" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="Resize the panes" />
    <Setter Property="ToolTip" Value="Drag to resize the panes" />
  </Style>

  <!-- ── Buttons ───────────────────────────────────────────────────────────── -->

  <!-- A flat, square icon button for the toolbars above lists and panes. -->
  <Style x:Key="ToolButton" TargetType="Button">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="3"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.SubtleBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Selection}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A text button that reads as a hyperlink; used on the welcome surface and in banners. -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="P"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="P" Property="TextBlock.TextDecorations" Value="Underline" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One segment of the animation-mode control. -->
  <Style x:Key="SegmentButton" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" Margin="1"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="12" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A severity filter pill in the problems panel: readable in both themes, checked or not. -->
  <Style x:Key="FilterToggle" TargetType="ToggleButton">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" CornerRadius="11" BorderThickness="1"
                  Background="Transparent" BorderBrush="{DynamicResource App.SubtleBorder}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background"
                      Value="{DynamicResource App.ChromeBackground}" />
              <Setter TargetName="Chrome" Property="BorderBrush"
                      Value="{DynamicResource App.Border}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    The chevron that collapses a pane from its header strip. Checked means expanded, so the glyph
    points up ("fold this away"); unchecked points down. It is an ordinary ToggleButton, so Tab
    reaches it and Space or Enter works it, and the tooltip and automation name follow the state.
  -->
  <Style x:Key="PaneCollapseToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="ToolTip" Value="Collapse this pane" />
    <Setter Property="AutomationProperties.Name" Value="Collapse this pane" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" CornerRadius="3" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True">
            <TextBlock x:Name="Glyph" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.SubtleBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Selection}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="False">
        <Setter Property="ToolTip" Value="Expand this pane" />
        <Setter Property="AutomationProperties.Name" Value="Expand this pane" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    A slim scroll bar that is drawn whenever it exists. The stock one fades to nothing until the
    pointer is over it, which is fine for a document but not for a pane that has had to cut its own
    content short: there, a panel with no visible bar reads as broken rather than as scrollable.
  -->
  <Style x:Key="PaneScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="24">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Bar" Margin="2,0" CornerRadius="3" Opacity="0.5"
                              Background="{DynamicResource App.SecondaryText}"
                              SnapsToDevicePixels="True" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BadgeBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Badge.Background}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Badge.Foreground}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ── Dialogs ───────────────────────────────────────────────────────────── -->
  <!--
    Every dialog uses the same vocabulary: a heading, groups 16px apart, labels above their
    controls, and a right-aligned button row 20px below the content. Spacing is on the 8px grid
    (4px for tight pairings) so nothing clips at 150 % DPI.
  -->

  <Style x:Key="DialogHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="DialogSubheading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="DialogLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,8,4" />
  </Style>

  <Style x:Key="DialogGroup" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <!--
    A themed push button (phase 5). The dialog button styles below used to set only sizes, without
    BasedOn, which dropped the Fluent style for the classic light-grey Aero2 one: off-theme in the dark
    theme, and unreadable once classic text follows the theme. The default button carries the accent.
  -->
  <Style x:Key="PushButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Background" Value="{DynamicResource App.ChromeBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDefault" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Accent}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsDefault" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Selection}" />
              <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DialogButton" TargetType="Button" BasedOn="{StaticResource PushButton}">
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <Style x:Key="DialogSmallButton" TargetType="Button" BasedOn="{StaticResource PushButton}">
    <Setter Property="MinWidth" Value="76" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <Style x:Key="DialogCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource App.PaneBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style x:Key="TableHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
  </Style>

  <!-- ── Panel tabs ──────────────── ────────────────────────────────────────── -->
  <!--
    The tab strips of the library, the inspector and the bottom panel: slim text tabs in the pane
    header's colours with an accent underline on the selected one, so a tabbed pane reads like the
    titled panes of the earlier ATX tool rather than like a stock TabControl.
  -->
  <Style x:Key="PanelTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Chrome" Padding="9,6,9,5" Margin="0,0,2,0" Background="Transparent"
                  BorderThickness="0,0,0,2" BorderBrush="Transparent" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource PanelTabItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource App.ChromeBackground}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1"
                    Padding="4,0" MinHeight="28">
              <DockPanel>
                <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Center"
                                  Content="{TemplateBinding Tag}" />
                <TabPanel IsItemsHost="True" VerticalAlignment="Bottom" />
              </DockPanel>
            </Border>
            <ContentPresenter ContentSource="SelectedContent" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A flat toggle that reads like ToolButton, accent-tinted when on (viewport toolbar). -->
  <Style x:Key="ToolToggle" TargetType="ToggleButton">
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" CornerRadius="3" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.SubtleBorder}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.AccentSoft}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ── Tree and list items (phase 5) ─────────────────────────────────────── -->
  <!--
    Why these exist: a view that gives a TreeView or ListBox an ItemContainerStyle without BasedOn
    drops the Fluent implicit style and gets the classic (Aero2) one instead, whose TreeViewItem paints
    its text with SystemColors.ControlTextBrush (black) and its expander arrows in fixed dark greys —
    almost invisible in the dark theme (the mesh Structure tree in phase 4). These compact items take
    every colour from the app's theme brushes; item container styles are BasedOn them, and they are
    also the implicit item styles, so a tree or list without its own container style matches.
  -->
  <Style x:Key="TreeExpanderToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Padding="0">
            <TextBlock x:Name="Glyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource App.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PaneTreeViewItem" TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="1,1" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>
            <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpanderToggle}" ClickMode="Press"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}" CornerRadius="3"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Selection}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectionInactive}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
        <Setter Property="ItemsPanel">
          <Setter.Value>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="PaneListBoxItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  CornerRadius="3" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Selection}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectionInactive}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TreeViewItem" BasedOn="{StaticResource PaneTreeViewItem}" />
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource PaneListBoxItem}" />

  <!--
    Column lists (Cairn.Ui.Controls.GridList). The Fluent theme's implicit ListView and ListViewItem styles have no
    GridView support: a plain ListView with a GridView loses its header row and draws each row's ToString(). GridList
    is a ListView subclass (so the Fluent ListView style, keyed by the exact type, does not apply and the GridView
    template does) and gives its rows and headers these styles.
  -->
  <Style x:Key="GridListHeader" TargetType="GridViewColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="Background" Value="{DynamicResource App.ChromeBackground}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource App.SubtleBorder}" BorderThickness="0,0,1,1" Padding="8,4,8,4">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Border>
            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="6" Margin="0,0,-3,0" Cursor="SizeWE">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="Padding">
              <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GridListItem" TargetType="ListViewItem">
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="0,2,0,2" SnapsToDevicePixels="True">
            <GridViewRowPresenter VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectionInactive}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Selection}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A row in a read-only facts list: a muted label column and a selectable value. -->
  <Style x:Key="FactLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource App.SecondaryText}" />
    <Setter Property="Margin" Value="0,2,10,2" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="FactValue" TargetType="TextBox">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,2,0,2" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

    <!-- ── Document tabs (shell tab strip) ─────────────────────────────────── -->

    <Style x:Key="DocumentTabItem" TargetType="TabItem">
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <!-- The theme's text colour (white on dark), not WPF's dark system default the header would otherwise inherit. -->
      <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Margin="0,2,1,0" Padding="11,5,5,5" CornerRadius="5,5,0,0"
                    Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" SnapsToDevicePixels="True">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Width="18" Height="18" Margin="8,0,0,0" Padding="0"
                        Style="{StaticResource ToolButton}" MinWidth="18" Focusable="False"
                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" ToolTip="Close this tab (Ctrl+W)" AutomationProperties.Name="Close tab">
                  <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource App.SecondaryText}" />
                </Button>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.Hover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource App.PaneBackground}" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The tab strip only: each document's view lives in DocumentHost, one instance per tab kept alive. -->
    <Style x:Key="DocumentTabControl" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Border Background="{DynamicResource App.ChromeBackground}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="4,2,6,2" VerticalAlignment="Center"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Open a file (Ctrl+O)" AutomationProperties.Name="Open a file">
                  <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="6,0,0,0">
                  <TabPanel IsItemsHost="True" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


</ResourceDictionary>