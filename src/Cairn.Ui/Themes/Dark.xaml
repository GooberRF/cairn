<!--
  Dark colour set. Key-for-key identical to Light.xaml; see that file for the contract.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Surfaces ──────────────────────────────────────────────────────────── -->
  <Color x:Key="App.WindowBackgroundColor">#FF1F1F22</Color>
  <Color x:Key="App.PaneBackgroundColor">#FF26262A</Color>
  <Color x:Key="App.ChromeBackgroundColor">#FF2D2D32</Color>
  <Color x:Key="App.BorderColor">#FF3C3C43</Color>
  <Color x:Key="App.SubtleBorderColor">#FF333338</Color>
  <Color x:Key="App.TextColor">#FFEDEDF0</Color>
  <Color x:Key="App.SecondaryTextColor">#FFA6A6AE</Color>
  <Color x:Key="App.AccentColor">#FF5CA0F2</Color>
  <!-- Text drawn on top of App.Accent. The dark theme's accent is a light blue, so the readable
       pairing is a dark ink rather than white. -->
  <Color x:Key="App.AccentForegroundColor">#FF0E1B2B</Color>
  <Color x:Key="App.AccentSoftColor">#FF23354D</Color>
  <Color x:Key="App.HoverColor">#FF32323A</Color>
  <Color x:Key="App.SelectionColor">#FF2E4A6E</Color>
  <Color x:Key="App.SelectionInactiveColor">#FF35353C</Color>

  <SolidColorBrush x:Key="App.WindowBackground" Color="{StaticResource App.WindowBackgroundColor}" />
  <SolidColorBrush x:Key="App.PaneBackground" Color="{StaticResource App.PaneBackgroundColor}" />
  <SolidColorBrush x:Key="App.ChromeBackground" Color="{StaticResource App.ChromeBackgroundColor}" />
  <SolidColorBrush x:Key="App.Border" Color="{StaticResource App.BorderColor}" />
  <SolidColorBrush x:Key="App.SubtleBorder" Color="{StaticResource App.SubtleBorderColor}" />
  <SolidColorBrush x:Key="App.Text" Color="{StaticResource App.TextColor}" />
  <SolidColorBrush x:Key="App.SecondaryText" Color="{StaticResource App.SecondaryTextColor}" />
  <SolidColorBrush x:Key="App.Accent" Color="{StaticResource App.AccentColor}" />
  <SolidColorBrush x:Key="App.AccentForeground" Color="{StaticResource App.AccentForegroundColor}" />
  <SolidColorBrush x:Key="App.AccentSoft" Color="{StaticResource App.AccentSoftColor}" />
  <SolidColorBrush x:Key="App.Hover" Color="{StaticResource App.HoverColor}" />
  <SolidColorBrush x:Key="App.Selection" Color="{StaticResource App.SelectionColor}" />
  <SolidColorBrush x:Key="App.SelectionInactive" Color="{StaticResource App.SelectionInactiveColor}" />

  <!-- ── Severity ──────────────────────────────────────────────────────────── -->
  <Color x:Key="Severity.ErrorColor">#FFFF7B6B</Color>
  <Color x:Key="Severity.WarningColor">#FFE0A030</Color>
  <Color x:Key="Severity.InfoColor">#FF6FB0F5</Color>
  <SolidColorBrush x:Key="Severity.Error" Color="{StaticResource Severity.ErrorColor}" />
  <SolidColorBrush x:Key="Severity.Warning" Color="{StaticResource Severity.WarningColor}" />
  <SolidColorBrush x:Key="Severity.Info" Color="{StaticResource Severity.InfoColor}" />
  <SolidColorBrush x:Key="Severity.ErrorSoft" Color="#FF3A2320" />
  <SolidColorBrush x:Key="Severity.WarningSoft" Color="#FF39301C" />
  <SolidColorBrush x:Key="Severity.InfoSoft" Color="#FF20303F" />

  <!-- ── Banners ───────────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Banner.ErrorBackground" Color="#FF3A2320" />
  <SolidColorBrush x:Key="Banner.ErrorBorder" Color="#FF7A4238" />
  <SolidColorBrush x:Key="Banner.NoticeBackground" Color="#FF39301C" />
  <SolidColorBrush x:Key="Banner.NoticeBorder" Color="#FF7A6430" />
  <SolidColorBrush x:Key="Banner.InfoBackground" Color="#FF20303F" />
  <SolidColorBrush x:Key="Banner.InfoBorder" Color="#FF3C5C7C" />
  <SolidColorBrush x:Key="Banner.Foreground" Color="#FFEDEDF0" />

  <!-- ── Editor ────────────────────────────────────────────────────────────── -->
  <Color x:Key="Editor.BackgroundColor">#FF1B1B1E</Color>
  <Color x:Key="Editor.ForegroundColor">#FFE4E4E8</Color>
  <SolidColorBrush x:Key="Editor.Background" Color="{StaticResource Editor.BackgroundColor}" />
  <SolidColorBrush x:Key="Editor.Foreground" Color="{StaticResource Editor.ForegroundColor}" />
  <SolidColorBrush x:Key="Editor.LineNumber" Color="#FF6E6E78" />
  <SolidColorBrush x:Key="Editor.CurrentLine" Color="#FF26262C" />
  <SolidColorBrush x:Key="Editor.CurrentLineBorder" Color="#FF32323A" />
  <SolidColorBrush x:Key="Editor.FrameHighlight" Color="#FF24303E" />
  <SolidColorBrush x:Key="Editor.FrameHighlightBorder" Color="#FF35506E" />

  <!-- Syntax colours (also read as Color by the highlighting builder). -->
  <Color x:Key="Syntax.CommentColor">#FF6FA96F</Color>
  <Color x:Key="Syntax.TableColor">#FFC792EA</Color>
  <Color x:Key="Syntax.KeyColor">#FF7FB7F5</Color>
  <Color x:Key="Syntax.StringColor">#FFD98B70</Color>
  <Color x:Key="Syntax.NumberColor">#FF7FD0BE</Color>
  <Color x:Key="Syntax.BooleanColor">#FF9C8CF5</Color>
  <Color x:Key="Syntax.PunctuationColor">#FF9A9AA4</Color>

  <!-- ── Frames list ───────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Frames.RowAlternate" Color="#FF2A2A2F" />
  <SolidColorBrush x:Key="Frames.Grip" Color="#FF6B6B75" />
  <SolidColorBrush x:Key="Frames.ThumbnailBackground" Color="#FF1B1B1E" />
  <SolidColorBrush x:Key="Frames.InsertionIndicator" Color="{StaticResource App.AccentColor}" />
  <SolidColorBrush x:Key="Badge.Background" Color="#FF3A3A42" />
  <SolidColorBrush x:Key="Badge.Foreground" Color="#FFD6D6DC" />

  <!-- ── Preview ───────────────────────────────────────────────────────────── -->
  <Color x:Key="Preview.CheckerLightColor">#FF3A3A40</Color>
  <Color x:Key="Preview.CheckerDarkColor">#FF2A2A2F</Color>
  <SolidColorBrush x:Key="Preview.CheckerLightColorBrush" Color="{StaticResource Preview.CheckerLightColor}" />
  <SolidColorBrush x:Key="Preview.CheckerDarkColorBrush" Color="{StaticResource Preview.CheckerDarkColor}" />
  <SolidColorBrush x:Key="Preview.Background" Color="#FF202024" />

  <SolidColorBrush x:Key="Preview.Black" Color="#FF000000" />
  <SolidColorBrush x:Key="Preview.White" Color="#FFFFFFFF" />

  <!-- ── Transport and scrubber ────────────────────────────────────────────── -->
  <Color x:Key="Scrubber.TrackColor">#FF2A2A30</Color>
  <Color x:Key="Scrubber.SegmentColor">#FF3A4557</Color>
  <Color x:Key="Scrubber.SegmentAlternateColor">#FF434F63</Color>
  <Color x:Key="Scrubber.SegmentBorderColor">#FF515F76</Color>
  <Color x:Key="Scrubber.HoverColor">#FF4E6383</Color>
  <SolidColorBrush x:Key="Scrubber.Track" Color="{StaticResource Scrubber.TrackColor}" />
  <SolidColorBrush x:Key="Scrubber.Segment" Color="{StaticResource Scrubber.SegmentColor}" />
  <SolidColorBrush x:Key="Scrubber.SegmentAlternate" Color="{StaticResource Scrubber.SegmentAlternateColor}" />
  <SolidColorBrush x:Key="Scrubber.SegmentBorder" Color="{StaticResource Scrubber.SegmentBorderColor}" />
  <SolidColorBrush x:Key="Scrubber.Hover" Color="{StaticResource Scrubber.HoverColor}" />
  <SolidColorBrush x:Key="Scrubber.Current" Color="{StaticResource App.AccentColor}" />
  <SolidColorBrush x:Key="Frames.PlayingMarker" Color="{StaticResource App.AccentColor}" />

  <!-- ── Tables (bulk timing preview, shortcut list) ───────────────────────── -->
  <SolidColorBrush x:Key="Table.HeaderBackground" Color="#FF2D2D32" />
  <SolidColorBrush x:Key="Table.ChangedBackground" Color="#FF39301C" />

  <!-- ── Help documents ────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Help.CodeBackground" Color="#FF2A2A30" />
  <SolidColorBrush x:Key="Help.RuleBrush" Color="#FF3C3C43" />

  <DrawingBrush x:Key="Preview.CheckerBrush" TileMode="Tile" Stretch="None"
                Viewport="0,0,16,16" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{StaticResource Preview.CheckerLightColorBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,16,16" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{StaticResource Preview.CheckerDarkColorBrush}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="0,0,8,8" />
              <RectangleGeometry Rect="8,8,8,8" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ── Viewport ─────────────────────────────────────────────────────────── -->
  <Color x:Key="Viewport.BackgroundColor">#FF2B2C31</Color>
  <SolidColorBrush x:Key="Viewport.Background" Color="{StaticResource Viewport.BackgroundColor}" />
  <SolidColorBrush x:Key="Viewport.Grid" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Viewport.GridMajor" Color="#47FFFFFF" />
  <SolidColorBrush x:Key="Viewport.AxisX" Color="#FFFF6B6B" />
  <SolidColorBrush x:Key="Viewport.AxisY" Color="#FF6BD47A" />
  <SolidColorBrush x:Key="Viewport.AxisZ" Color="#FF6FA8FF" />
  <SolidColorBrush x:Key="Viewport.Bone" Color="#E6F2F4F8" />
  <SolidColorBrush x:Key="Viewport.BoneOutline" Color="#CC000000" />
  <SolidColorBrush x:Key="Viewport.Joint" Color="#FFFFC34D" />
  <SolidColorBrush x:Key="Viewport.BoneSelected" Color="#FFFF9A3D" />
  <SolidColorBrush x:Key="Viewport.BoneHover" Color="#FF5CD0FF" />
  <SolidColorBrush x:Key="Viewport.Sphere" Color="#CC3FD6BF" />
  <SolidColorBrush x:Key="Viewport.Prop" Color="#FFE070E8" />
  <SolidColorBrush x:Key="Viewport.RootPath" Color="#FF6FA8FF" />
  <SolidColorBrush x:Key="Viewport.Label" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Viewport.LabelBackground" Color="#B3000000" />
  <SolidColorBrush x:Key="Viewport.Highlight" Color="#FFFF9A3D" />
  <SolidColorBrush x:Key="Viewport.Notice" Color="#E62D2D32" />
  <SolidColorBrush x:Key="Viewport.NoticeText" Color="#FFEDEDF0" />
  <Color x:Key="Viewport.FlatMeshColor">#FF9EA3AD</Color>
  <Color x:Key="Viewport.MissingTextureColor">#FFA98A9A</Color>
  <Color x:Key="Viewport.HighlightTintColor">#66FF9A3D</Color>
  <SolidColorBrush x:Key="Viewport.ToolbarBackground" Color="#E626262A" />

  <!-- ── Timeline scrubber ────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Scrubber.Ramp" Color="#59FF9A3D" />
  <SolidColorBrush x:Key="Scrubber.Tick" Color="#FF55555E" />
  <SolidColorBrush x:Key="Scrubber.KeyMark" Color="#FFA6A6AE" />

  <!-- ── Ghost skeletons (phase 5) ─────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Viewport.Ghost" Color="#998FA8FF" />
  <SolidColorBrush x:Key="Viewport.GhostCompare" Color="#B3FFB070" />

  <!-- ── Timeline / dope sheet (phase 5) ───────────────────────────────────── -->
  <SolidColorBrush x:Key="Timeline.Background" Color="#FF222226" />
  <SolidColorBrush x:Key="Timeline.HeaderBackground" Color="#FF2A2A2F" />
  <SolidColorBrush x:Key="Timeline.RowAlternate" Color="#FF27272C" />
  <SolidColorBrush x:Key="Timeline.RowSelected" Color="#FF2E3F57" />
  <SolidColorBrush x:Key="Timeline.Grid" Color="#FF2E2E34" />
  <SolidColorBrush x:Key="Timeline.GridMajor" Color="#FF3E3E46" />
  <SolidColorBrush x:Key="Timeline.OutOfRange" Color="#59000000" />
  <SolidColorBrush x:Key="Timeline.RotationKey" Color="#FFE8B54A" />
  <SolidColorBrush x:Key="Timeline.PositionKey" Color="#FF5CB8F0" />
  <SolidColorBrush x:Key="Timeline.SummaryKey" Color="#FFB4B4BE" />
  <SolidColorBrush x:Key="Timeline.KeySelected" Color="#FFFF7A2E" />
  <SolidColorBrush x:Key="Timeline.KeyHover" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Timeline.KeyOutline" Color="#CC101014" />
  <SolidColorBrush x:Key="Timeline.SelectionBox" Color="#335CA0F2" />
  <SolidColorBrush x:Key="Timeline.SelectionBoxBorder" Color="#FF5CA0F2" />
  <SolidColorBrush x:Key="Timeline.Handle" Color="#FFFF7A2E" />

  <!-- ── Gizmos (phase 5) ──────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Gizmo.AxisX" Color="#FFFF5A5A" />
  <SolidColorBrush x:Key="Gizmo.AxisY" Color="#FF5FD870" />
  <SolidColorBrush x:Key="Gizmo.AxisZ" Color="#FF5C9DFF" />
  <SolidColorBrush x:Key="Gizmo.Screen" Color="#FFE8EAF0" />
  <SolidColorBrush x:Key="Gizmo.Hover" Color="#FFFFD23F" />
  <SolidColorBrush x:Key="Gizmo.Outline" Color="#B3000000" />
  <SolidColorBrush x:Key="Gizmo.Trackball" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Gizmo.TrackballHover" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="Gizmo.ReadoutBackground" Color="#E6000000" />
  <SolidColorBrush x:Key="Gizmo.ReadoutText" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PoseBadge.Background" Color="#E626262A" />
  <SolidColorBrush x:Key="PoseBadge.Text" Color="#FFEDEDF0" />
  <SolidColorBrush x:Key="PoseBadge.HintText" Color="#FFC2C2CA" />
  <SolidColorBrush x:Key="PoseBadge.AutoKey" Color="#FFFF5A5A" />
  <SolidColorBrush x:Key="PoseBadge.Layer" Color="#FFB78CFF" />
  <SolidColorBrush x:Key="PoseBadge.Ik" Color="#FF3FD6BF" />
  <SolidColorBrush x:Key="PoseBadge.Mesh" Color="#FFF2B33D" />

  <!-- ── System colour keys (phase 5, table usage / theme audit) ───────────── -->
  <!-- See Light.xaml: classic-template text and selection colours, mapped to the theme. -->
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource App.TextColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="{StaticResource App.TextColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="{StaticResource App.TextColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource App.SelectionColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource App.TextColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource App.SelectionInactiveColor}" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource App.TextColor}" />

</ResourceDictionary>
